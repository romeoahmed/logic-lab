@inject IStringLocalizer<EditorText> Text

<div class="status-strip"
     role="region"
     aria-label="@Text["WorkbenchTelemetryAriaLabel"]"
     aria-busy="@(!IsConnected)"
     data-connection-state="@(IsConnected ? "connected" : "connecting")">
    <dl class="status-facts" aria-label="@Text["WorkbenchStatusAriaLabel"]">
        <div data-status="connection">
            <dt>@Text["Connection"]</dt>
            <dd><span class="@StatusDotClass" aria-hidden="true"></span>@Connection</dd>
        </div>
        <div data-status="logical-time">
            <dt>@Text["LogicalTime"]</dt>
            <dd>@LogicalTime</dd>
        </div>
        <div data-status="quiescence">
            <dt>@Text["Quiescence"]</dt>
            <dd>@Quiescence</dd>
        </div>
        <div data-status="trace">
            <dt>@Text["TraceRange"]</dt>
            <dd>@TraceRange</dd>
        </div>
        <div data-status="compilation">
            <dt>@Text["Compilation"]</dt>
            <dd>@Compilation</dd>
        </div>
        <div data-status="save">
            <dt>@Text["Save"]</dt>
            <dd>@Save</dd>
        </div>
    </dl>
    <p class="status-message" role="status" aria-live="polite">@Message</p>
</div>
