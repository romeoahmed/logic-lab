<div class="status-strip">
    <dl class="status-facts" aria-label="Workbench status">
        <div data-status="connection">
            <dt>Connection</dt>
            <dd><span class="@StatusDotClass" aria-hidden="true"></span>@State.Connection</dd>
        </div>
        <div data-status="logical-time">
            <dt>Logical time</dt>
            <dd>@State.LogicalTime</dd>
        </div>
        <div data-status="quiescence">
            <dt>Quiescence</dt>
            <dd>@State.Quiescence</dd>
        </div>
        <div data-status="trace">
            <dt>Trace range</dt>
            <dd>@State.TraceRange</dd>
        </div>
        <div data-status="compilation">
            <dt>Compilation</dt>
            <dd>@State.Compilation</dd>
        </div>
        <div data-status="save">
            <dt>Save</dt>
            <dd>@State.Save</dd>
        </div>
    </dl>
    <p class="status-message" role="status" aria-live="polite">@Message</p>
</div>

@code {
    [Parameter]
    public WorkbenchStatusState State { get; set; } = WorkbenchStatusState.StaticShell;

    [Parameter, EditorRequired]
    public string Message { get; set; } = "Ready.";

    private string StatusDotClass => State.IsConnected
        ? "status-dot is-connected"
        : "status-dot is-connecting";
}
