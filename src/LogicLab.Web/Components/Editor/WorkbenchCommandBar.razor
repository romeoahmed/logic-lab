@inject IStringLocalizer<EditorText> Text

<div class="command-bar" data-active-command="@Model.ActiveCommand">
    @if (Model.ShowHistory)
    {
        <div class="history-actions">
            <FluentButton data-command="undo"
                          Appearance="ButtonAppearance.Outline"
                          Disabled="@(!Model.CanUndo || IsBusy)"
                          OnClick="@(() => OnCommand.InvokeAsync(WorkbenchCommand.Undo))">@Text["Undo"]</FluentButton>
            <FluentButton data-command="redo"
                          Appearance="ButtonAppearance.Outline"
                          Disabled="@(!Model.CanRedo || IsBusy)"
                          OnClick="@(() => OnCommand.InvokeAsync(WorkbenchCommand.Redo))">@Text["Redo"]</FluentButton>
        </div>
    }
    <div class="workflow-actions">
        @{ var actions = WorkflowActions; }
        @foreach (var action in actions)
        {
            <FluentButton @key="action.Command"
                          data-command="@action.Key"
                          hidden="@(!action.Available)"
                          Appearance="@(action.Primary ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                          Disabled="@(!action.Available || IsBusy)"
                          Loading="@(Model.ActiveCommand == action.Key)"
                          OnClick="@(() => OnCommand.InvokeAsync(action.Command))">@Text[action.Label]</FluentButton>
        }
        @if (!actions.Any(action => action.Available))
        {
            <span class="workflow-hint">@Text[Model.ShowHistory ? "AuthorCircuitHint" : "ChooseStarterHint"]</span>
        }
    </div>

    <FluentMenuButton Id="project-options-trigger"
                      data-testid="project-options-trigger"
                      Class="project-options-trigger"
                      Appearance="ButtonAppearance.Subtle"
                      Disabled="IsBusy"
                      OnClick="ToggleProjectOptions">@Text["ProjectOptions"]</FluentMenuButton>
    <FluentPopover Id="project-options-popover"
                   Class="project-options-popover"
                   AnchorId="project-options-trigger"
                   OffsetVertical="6"
                   Width="10rem"
                   @bind-Opened="projectOptionsOpened">
        <div class="project-options-panel" data-testid="project-options-panel">
            <div class="project-actions">
                <label class="import-picker">
                    @Text["ImportProject"]
                    <InputFile data-command="import"
                               accept=".logiclab,application/vnd.logiclab+zip"
                               disabled="@(!Model.CanImport || IsBusy)"
                               OnChange="OnImport" />
                </label>
                <FluentButton data-command="export"
                              Appearance="ButtonAppearance.Outline"
                              Disabled="@(!Model.CanPrepareExport || IsBusy)"
                              Loading="@(Model.ActiveCommand is "export")"
                              OnClick="@(() => InvokeProjectCommandAsync(WorkbenchCommand.PrepareExport))">@Text["PrepareExport"]</FluentButton>
                @if (Model.ShowClaim)
                {
                    <FluentTextInput data-claim-name
                                     Id="claim-project-name"
                                     Label="@Text["DurableProjectName"]"
                                     Value="@Model.ClaimDisplayName"
                                     ValueChanged="ClaimDisplayNameChanged"
                                     Immediate="true"
                                     MaxLength="256"
                                     AutoComplete="off"
                                     Disabled="IsBusy"
                                     Size="TextInputSize.Small"
                                     Width="100%" />
                    <FluentButton data-command="claim"
                                  Appearance="ButtonAppearance.Primary"
                                  Disabled="@(!Model.CanClaim || IsBusy)"
                                  Loading="@(Model.ActiveCommand is "claim")"
                                  OnClick="@(() => InvokeProjectCommandAsync(WorkbenchCommand.Claim))">@Text["KeepDurable"]</FluentButton>
                }
                @if (Model.ShowSave)
                {
                    <FluentButton data-command="save"
                                  Appearance="@(Model.CanSave ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                                  Disabled="@(!Model.CanSave || IsBusy)"
                                  Loading="@(Model.ActiveCommand is "save")"
                                  OnClick="@(() => InvokeProjectCommandAsync(WorkbenchCommand.Save))">@Text["SaveDurable"]</FluentButton>
                }
            </div>
        </div>
    </FluentPopover>
</div>
