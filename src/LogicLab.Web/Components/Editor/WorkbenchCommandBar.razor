<div class="command-bar" role="group" aria-label="Workbench commands">
    <div class="command-cluster" role="group" aria-label="Project commands">
        <span class="command-cluster-label">Project</span>
        <div>
            <FluentButton data-command="create"
                          Appearance="@(CanAuthor ? ButtonAppearance.Outline : ButtonAppearance.Primary)"
                          Disabled="@(!CanCreate || IsBusy)"
                          Loading="@(ActiveCommand is "create")"
                          OnClick="OnCreate">Create Sandbox Project</FluentButton>
            <FluentButton data-command="author"
                          Disabled="@(!CanAuthor || IsBusy)"
                          Loading="@(ActiveCommand is "author")"
                          OnClick="OnAuthor">Author circuit</FluentButton>
            <label class="import-command">
                <span>Import .logiclab</span>
                <InputFile data-command="import"
                           accept=".logiclab,application/vnd.logiclab+zip"
                           disabled="@(!CanImport || IsBusy)"
                           OnChange="OnImport" />
            </label>
            <FluentButton data-command="export"
                          Disabled="@(!CanPrepareExport || IsBusy)"
                          Loading="@(ActiveCommand is "export")"
                          OnClick="OnPrepareExport">Prepare export</FluentButton>
        </div>
    </div>
    <div class="command-cluster" role="group" aria-label="Example authoring commands">
        <span class="command-cluster-label">Templates</span>
        <div>
            <FluentButton data-command="author-steering"
                          Appearance="ButtonAppearance.Subtle"
                          Disabled="@(!CanAuthorSteering || IsBusy)"
                          Loading="@(ActiveCommand is "author-steering")"
                          OnClick="OnAuthorSteering">Steering</FluentButton>
            <FluentButton data-command="author-arithmetic"
                          Appearance="ButtonAppearance.Subtle"
                          Disabled="@(!CanAuthorArithmetic || IsBusy)"
                          Loading="@(ActiveCommand is "author-arithmetic")"
                          OnClick="OnAuthorArithmetic">Arithmetic</FluentButton>
            <FluentButton data-command="author-hierarchy"
                          Appearance="ButtonAppearance.Subtle"
                          Disabled="@(!CanAuthorHierarchy || IsBusy)"
                          Loading="@(ActiveCommand is "author-hierarchy")"
                          OnClick="OnAuthorHierarchy">Hierarchy</FluentButton>
        </div>
    </div>
    <div class="command-cluster" role="group" aria-label="Build command">
        <span class="command-cluster-label">Build</span>
        <div>
            <FluentButton data-command="compile"
                          Disabled="@(!CanCompile || IsBusy)"
                          Loading="@(ActiveCommand is "compile")"
                          OnClick="OnCompile">Compile</FluentButton>
        </div>
    </div>
    <div class="command-cluster" role="group" aria-label="Simulation commands">
        <span class="command-cluster-label">Simulation</span>
        <div>
            <FluentButton data-command="session"
                          Disabled="@(!CanCreateSession || IsBusy)"
                          Loading="@(ActiveCommand is "session")"
                          OnClick="OnCreateSession">Create Session</FluentButton>
            <FluentButton data-command="stimulus"
                          Disabled="@(!CanScheduleStimulus || IsBusy)"
                          Loading="@(ActiveCommand is "stimulus")"
                          OnClick="OnScheduleStimulus">Inputs = 1</FluentButton>
            <FluentButton data-command="step"
                          Appearance="@(CanStep ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                          Disabled="@(!CanStep || IsBusy)"
                          Loading="@(ActiveCommand is "step")"
                          OnClick="OnStep">Step</FluentButton>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool CanCreate { get; set; }

    [Parameter]
    public bool CanAuthor { get; set; }

    [Parameter]
    public bool CanImport { get; set; }

    [Parameter]
    public bool CanPrepareExport { get; set; }

    [Parameter]
    public bool CanAuthorSteering { get; set; }

    [Parameter]
    public bool CanAuthorArithmetic { get; set; }

    [Parameter]
    public bool CanAuthorHierarchy { get; set; }

    [Parameter]
    public bool CanCompile { get; set; }

    [Parameter]
    public bool CanCreateSession { get; set; }

    [Parameter]
    public bool CanScheduleStimulus { get; set; }

    [Parameter]
    public bool CanStep { get; set; }

    [Parameter]
    public string? ActiveCommand { get; set; }

    [Parameter]
    public EventCallback OnCreate { get; set; }

    [Parameter]
    public EventCallback OnAuthor { get; set; }

    [Parameter]
    public EventCallback<InputFileChangeEventArgs> OnImport { get; set; }

    [Parameter]
    public EventCallback OnPrepareExport { get; set; }

    [Parameter]
    public EventCallback OnAuthorSteering { get; set; }

    [Parameter]
    public EventCallback OnAuthorArithmetic { get; set; }

    [Parameter]
    public EventCallback OnAuthorHierarchy { get; set; }

    [Parameter]
    public EventCallback OnCompile { get; set; }

    [Parameter]
    public EventCallback OnCreateSession { get; set; }

    [Parameter]
    public EventCallback OnScheduleStimulus { get; set; }

    [Parameter]
    public EventCallback OnStep { get; set; }

    private bool IsBusy => ActiveCommand is not null;
}
