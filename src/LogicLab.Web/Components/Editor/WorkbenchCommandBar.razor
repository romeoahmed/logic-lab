@using Microsoft.FluentUI.AspNetCore.Components

<nav class="command-bar" aria-label="Workbench commands">
    <FluentButton data-command="create"
                  Appearance="ButtonAppearance.Primary"
                  Disabled="@(!EffectiveState.CanCreate)"
                  Loading="@(ActiveCommand is WorkbenchCommandKind.Create)"
                  OnClick="OnCreate">Create Sandbox Project</FluentButton>
    <FluentButton data-command="author"
                  Disabled="@(!EffectiveState.CanAuthor)"
                  Loading="@(ActiveCommand is WorkbenchCommandKind.Author)"
                  OnClick="OnAuthor">Author circuit</FluentButton>
    <FluentButton data-command="compile"
                  Disabled="@(!EffectiveState.CanCompile)"
                  Loading="@(ActiveCommand is WorkbenchCommandKind.Compile)"
                  OnClick="OnCompile">Compile</FluentButton>
    <FluentButton data-command="session"
                  Disabled="@(!EffectiveState.CanCreateSession)"
                  Loading="@(ActiveCommand is WorkbenchCommandKind.CreateSession)"
                  OnClick="OnCreateSession">Create Session</FluentButton>
    <FluentButton data-command="stimulus"
                  Disabled="@(!EffectiveState.CanScheduleStimulus)"
                  Loading="@(ActiveCommand is WorkbenchCommandKind.ScheduleStimulus)"
                  OnClick="OnScheduleStimulus">Set input to 1</FluentButton>
    <FluentButton data-command="step"
                  Appearance="ButtonAppearance.Primary"
                  Disabled="@(!EffectiveState.CanStep)"
                  Loading="@(ActiveCommand is WorkbenchCommandKind.Step)"
                  OnClick="OnStep">Step</FluentButton>
</nav>

@code {
    [Parameter, EditorRequired]
    public WorkbenchViewState State { get; set; } = WorkbenchViewState.StaticShell;

    [Parameter]
    public WorkbenchCommandKind? ActiveCommand { get; set; }

    [Parameter]
    public EventCallback OnCreate { get; set; }

    [Parameter]
    public EventCallback OnAuthor { get; set; }

    [Parameter]
    public EventCallback OnCompile { get; set; }

    [Parameter]
    public EventCallback OnCreateSession { get; set; }

    [Parameter]
    public EventCallback OnScheduleStimulus { get; set; }

    [Parameter]
    public EventCallback OnStep { get; set; }

    private WorkbenchViewState EffectiveState => ActiveCommand is null
        ? State
        : WorkbenchViewState.StaticShell;
}
