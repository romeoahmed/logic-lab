@inject IStringLocalizer<EditorText> Text

<div class="command-bar"
     role="group"
     aria-label="@Text["WorkbenchCommandsAriaLabel"]"
     aria-busy="@(IsBusy ? "true" : "false")"
     data-active-command="@Model.ActiveCommand">
    <div class="command-cluster" role="group" aria-label="@Text["NextStepAriaLabel"]">
        <span class="command-cluster-label">@Text["NextStep"]</span>
        <div class="workflow-actions">
            <FluentButton data-command="create"
                          hidden="@(!Model.CanCreate)"
                          Appearance="ButtonAppearance.Primary"
                          Disabled="@(!Model.CanCreate || IsBusy)"
                          Loading="@(Model.ActiveCommand is "create")"
                          OnClick="@(() => OnCommand.InvokeAsync(WorkbenchCommand.Create))">@Text["CreateSandbox"]</FluentButton>
            <FluentButton data-command="compile"
                          hidden="@(!Model.CanCompile)"
                          Appearance="ButtonAppearance.Primary"
                          Disabled="@(!Model.CanCompile || IsBusy)"
                          Loading="@(Model.ActiveCommand is "compile")"
                          OnClick="@(() => OnCommand.InvokeAsync(WorkbenchCommand.Compile))">@Text["Compile"]</FluentButton>
            <FluentButton data-command="session"
                          hidden="@(!Model.CanCreateSession)"
                          Appearance="ButtonAppearance.Primary"
                          Disabled="@(!Model.CanCreateSession || IsBusy)"
                          Loading="@(Model.ActiveCommand is "session")"
                          OnClick="@(() => OnCommand.InvokeAsync(WorkbenchCommand.CreateSession))">@Text["CreateSession"]</FluentButton>
            <FluentButton data-command="stimulus"
                          hidden="@(!Model.CanScheduleStimulus)"
                          Appearance="ButtonAppearance.Primary"
                          Disabled="@(!Model.CanScheduleStimulus || IsBusy)"
                          Loading="@(Model.ActiveCommand is "stimulus")"
                          OnClick="@(() => OnCommand.InvokeAsync(WorkbenchCommand.ScheduleStimulus))">@Text["InputsHigh"]</FluentButton>
            <FluentButton data-command="step"
                          hidden="@(!Model.CanStep)"
                          Appearance="ButtonAppearance.Primary"
                          Disabled="@(!Model.CanStep || IsBusy)"
                          Loading="@(Model.ActiveCommand is "step")"
                          OnClick="@(() => OnCommand.InvokeAsync(WorkbenchCommand.Step))">@Text["Step"]</FluentButton>
            @if (!Model.CanCreate && !Model.CanCompile && !Model.CanCreateSession && !Model.CanScheduleStimulus && !Model.CanStep)
            {
                <span class="workflow-hint">@Text["ChooseStarterHint"]</span>
            }
        </div>
    </div>

    <details class="project-options">
        <summary>@Text["ProjectOptions"]</summary>
        <div class="project-actions" role="group" aria-label="@Text["ProjectCommandsAriaLabel"]">
            <FluentInputFile Id="logiclab-import-picker"
                             AnchorId="logiclab-import-trigger"
                             Accept=".logiclab,application/vnd.logiclab+zip"
                             aria-hidden="true"
                             tabindex="-1"
                             Disabled="@(!Model.CanImport || IsBusy)"
                             DragDropZoneVisible="false"
                             OnInputFileChange="OnImport" />
            <FluentButton Id="logiclab-import-trigger"
                          data-command="import"
                          aria-label="@Text["ImportAriaLabel"]"
                          Appearance="ButtonAppearance.Outline"
                          Disabled="@(!Model.CanImport || IsBusy)"
                          Loading="@(Model.ActiveCommand is "import")">@Text["ImportProject"]</FluentButton>
            <FluentButton data-command="export"
                          Appearance="ButtonAppearance.Outline"
                          Disabled="@(!Model.CanPrepareExport || IsBusy)"
                          Loading="@(Model.ActiveCommand is "export")"
                          OnClick="@(() => OnCommand.InvokeAsync(WorkbenchCommand.PrepareExport))">@Text["PrepareExport"]</FluentButton>
            @if (Model.ShowClaim)
            {
                <FluentTextInput data-claim-name
                                 Id="claim-project-name"
                                 Label="@Text["DurableProjectName"]"
                                 Value="@Model.ClaimDisplayName"
                                 ValueChanged="ClaimDisplayNameChanged"
                                 Immediate="true"
                                 MaxLength="256"
                                 AutoComplete="off"
                                 Disabled="IsBusy"
                                 Size="TextInputSize.Small"
                                 Width="12rem" />
                <FluentButton data-command="claim"
                              Appearance="ButtonAppearance.Primary"
                              Disabled="@(!Model.CanClaim || IsBusy)"
                              Loading="@(Model.ActiveCommand is "claim")"
                              OnClick="@(() => OnCommand.InvokeAsync(WorkbenchCommand.Claim))">@Text["KeepDurable"]</FluentButton>
            }
            @if (Model.ShowSave)
            {
                <FluentButton data-command="save"
                              Appearance="@(Model.CanSave ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                              Disabled="@(!Model.CanSave || IsBusy)"
                              Loading="@(Model.ActiveCommand is "save")"
                              OnClick="@(() => OnCommand.InvokeAsync(WorkbenchCommand.Save))">@Text["SaveDurable"]</FluentButton>
            }
        </div>
    </details>
</div>
