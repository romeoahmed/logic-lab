@inject IStringLocalizer<EditorText> Text
@using LogicLab.Web.Scene

<div class="scene-tool-strip" role="toolbar" aria-label="@Text["SceneToolsAriaLabel"]">
    <button type="button"
            data-scene-tool="select"
            aria-pressed="@(ActiveTool is SceneSelectToolV1 ? "true" : "false")"
            @onclick="@(() => ChangeToolAsync(SceneSelectToolV1.Instance))">@Text["SelectTool"]</button>
    <label>
        <span>@Text["PlaceTool"]</span>
        <select data-scene-tool="place"
                class="@(ActiveTool is ScenePlaceToolV1 ? "active" : null)"
                aria-label="@Text["ComponentCatalogAriaLabel"]"
                value="@SelectedPlaceOptionId"
                @onchange="SelectPlaceToolAsync">
            <option value="">@Text["ChooseComponent"]</option>
            @foreach (var option in PlaceOptions)
            {
                <option @key="option.Id" value="@option.Id">@option.Label</option>
            }
        </select>
    </label>
    <button type="button"
            data-scene-tool="wire"
            aria-pressed="@(ActiveTool is SceneWireToolV1 ? "true" : "false")"
            @onclick="@(() => ChangeToolAsync(SceneWireToolV1.Instance))">@Text["WireTool"]</button>
    <button type="button"
            data-scene-tool="probe"
            disabled="@(!CanProbe || HierarchyPath is null)"
            aria-pressed="@(ActiveTool is SceneProbeToolV1 ? "true" : "false")"
            @onclick="SelectProbeToolAsync">@Text["Probe"]</button>
    <button type="button"
            data-scene-tool="pan"
            aria-pressed="@(ActiveTool is ScenePanToolV1 ? "true" : "false")"
            @onclick="@(() => ChangeToolAsync(ScenePanToolV1.Instance))">@Text["PanTool"]</button>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ScenePlaceOptionV1> PlaceOptions { get; set; } = [];

    [Parameter, EditorRequired]
    public SceneToolV1 ActiveTool { get; set; } = SceneSelectToolV1.Instance;

    [Parameter]
    public SceneHierarchyPathV1? HierarchyPath { get; set; }

    [Parameter]
    public bool CanProbe { get; set; }

    [Parameter]
    public EventCallback<SceneToolV1> ActiveToolChanged { get; set; }

    private string SelectedPlaceOptionId => ActiveTool is ScenePlaceToolV1 place
        ? place.Target switch
        {
            SceneLibraryComponentTargetV1 library =>
                $"library:{library.LibraryId}:{library.ContractId}",
            SceneCircuitDefinitionTargetV1 definition =>
                $"definition:{definition.CircuitDefinitionId}",
            _ => string.Empty,
        }
        : string.Empty;

    private Task ChangeToolAsync(SceneToolV1 tool) => ActiveToolChanged.InvokeAsync(tool);

    private Task SelectProbeToolAsync() => !CanProbe || HierarchyPath is null
        ? Task.CompletedTask
        : ChangeToolAsync(new SceneProbeToolV1(HierarchyPath));

    private Task SelectPlaceToolAsync(ChangeEventArgs change)
    {
        var option = PlaceOptions.FirstOrDefault(candidate => string.Equals(
            candidate.Id,
            change.Value?.ToString(),
            StringComparison.Ordinal));
        return option is null ? Task.CompletedTask : ChangeToolAsync(option.Tool);
    }
}
