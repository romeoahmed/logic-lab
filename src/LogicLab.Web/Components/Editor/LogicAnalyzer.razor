<section @key="rendererGeneration"
         class="logic-analyzer"
         aria-labelledby="logic-analyzer-heading"
         @ref="hostElement">
    <header class="analyzer-heading">
        <div>
            <p class="eyebrow">@Text["LogicAnalyzerEyebrow"]</p>
            <h2 id="logic-analyzer-heading">@Text["LogicAnalyzer"]</h2>
        </div>
        @if (Simulation is not null)
        {
            <dl class="analyzer-readout">
                <div>
                    <dt>@Text["LogicalTime"]</dt>
                    <dd>@Simulation.LogicalTime</dd>
                </div>
                <div>
                    <dt>@Text["SessionVersion"]</dt>
                    <dd>@Simulation.SessionVersion</dd>
                </div>
            </dl>
        }
    </header>

    @if (Simulation is null)
    {
        <div class="analyzer-empty" role="status">
            <span aria-hidden="true"></span>
            <p>@Text["NoActiveSession"]</p>
            <small>@Text["ProbeEmptyHelp"]</small>
        </div>
    }
    else if (!isOpen)
    {
        <div class="analyzer-collapsed">
            <span>@Text["LogicAnalyzerCollapsed"]</span>
            <FluentButton Type="ButtonType.Button"
                          Size="ButtonSize.Small"
                          Appearance="ButtonAppearance.Primary"
                          OnClick="@(_ => OpenAnalyzerAsync())">@Text["OpenLogicAnalyzer"]</FluentButton>
        </div>
    }
    else
    {
        <div class="analyzer-toolbar" role="toolbar" aria-label="@Text["WaveformControls"]">
            <div class="representation-control" role="group" aria-label="@Text["TraceResolution"]">
                <FluentToggleButton Type="ButtonType.Button"
                                    Size="ButtonSize.Small"
                                    Appearance="ButtonAppearance.Subtle"
                                    Pressed="@(!summaryRequested)"
                                    OnClick="@(_ => SetSummaryAsync(false))">@Text["TransitionDetail"]</FluentToggleButton>
                <FluentToggleButton Type="ButtonType.Button"
                                    Size="ButtonSize.Small"
                                    Appearance="ButtonAppearance.Subtle"
                                    Pressed="@summaryRequested"
                                    OnClick="@(_ => SetSummaryAsync(true))">@Text["VisualSummary"]</FluentToggleButton>
            </div>
            <div class="viewport-controls" role="group" aria-label="@Text["ViewportControls"]">
                <FluentButton Type="ButtonType.Button"
                              Size="ButtonSize.Small"
                              Appearance="ButtonAppearance.Subtle"
                              OnClick="@(_ => ZoomOutAsync())">@Text["ZoomOut"]</FluentButton>
                <FluentButton Type="ButtonType.Button"
                              Size="ButtonSize.Small"
                              Appearance="ButtonAppearance.Subtle"
                              OnClick="@(_ => FitAsync())">@Text["FitTrace"]</FluentButton>
                <FluentButton Type="ButtonType.Button"
                              Size="ButtonSize.Small"
                              Appearance="ButtonAppearance.Subtle"
                              OnClick="@(_ => ZoomInAsync())">@Text["ZoomIn"]</FluentButton>
                <FluentToggleButton Type="ButtonType.Button"
                                    Size="ButtonSize.Small"
                                    Appearance="ButtonAppearance.Subtle"
                                    Pressed="@liveFollow"
                                    OnClick="@(_ => ToggleLiveFollowAsync())">@Text["LiveFollow"]</FluentToggleButton>
            </div>
            <div class="cursor-controls" role="group" aria-label="@Text["MeasurementCursors"]">
                <FluentToggleButton Type="ButtonType.Button"
                                    Size="ButtonSize.Small"
                                    Appearance="ButtonAppearance.Subtle"
                                    Pressed="@(primaryCursor is not null)"
                                    OnClick="@(_ => ToggleCursorAsync(primary: true))">A</FluentToggleButton>
                <FluentToggleButton Type="ButtonType.Button"
                                    Size="ButtonSize.Small"
                                    Appearance="ButtonAppearance.Subtle"
                                    Pressed="@(secondaryCursor is not null)"
                                    OnClick="@(_ => ToggleCursorAsync(primary: false))">B</FluentToggleButton>
            </div>
            @if (primaryCursor is not null || secondaryCursor is not null)
            {
                <dl class="cursor-readout" aria-label="@Text["MeasurementCursors"]">
                    @if (primaryCursor is { } primary)
                    {
                        <div><dt>A</dt><dd>@primary</dd></div>
                    }
                    @if (secondaryCursor is { } secondary)
                    {
                        <div><dt>B</dt><dd>@secondary</dd></div>
                    }
                    @if (CursorDelta is { } delta)
                    {
                        <div><dt>Δt</dt><dd>@delta</dd></div>
                    }
                </dl>
            }
            <FluentButton Class="close-analyzer"
                          Type="ButtonType.Button"
                          Size="ButtonSize.Small"
                          Appearance="ButtonAppearance.Subtle"
                          OnClick="@(_ => CloseAnalyzerAsync())">
                @Text["CloseWaveform"]
            </FluentButton>
        </div>

        @if (Simulation.Probes.Count == 0 && recoveryRows.Count == 0)
        {
            <div class="analyzer-empty" role="status">
                <span aria-hidden="true"></span>
                <p>@Text["EmptyTrace"]</p>
                <small>@Text["EmptyTraceHelp"]</small>
            </div>
        }
        else if (snapshot is null)
        {
            @if (traceLoading)
            {
                <div class="analyzer-empty" role="status">
                    <FluentSpinner Size="SpinnerSize.Small" />
                    <p>@Text["LoadingTrace"]</p>
                </div>
            }
            else
            {
                <div class="analyzer-empty analyzer-load-failure" role="alert">
                    <p>@TraceFailureMessage</p>
                    <FluentButton Type="ButtonType.Button"
                                  Size="ButtonSize.Small"
                                  Appearance="ButtonAppearance.Primary"
                                  OnClick="@(_ => RetryAsync())">@Text["RetryWaveform"]</FluentButton>
                </div>
            }
        }
        else
        {
            <div class="analyzer-surface">
                <aside class="probe-spine"
                       data-probe-spine
                       aria-labelledby="probe-spine-heading">
                    <h3 id="probe-spine-heading">@Text["ProbeSpine"]</h3>
                    <ol>
                        @foreach (var row in Rows)
                        {
                            var formattedValue = Format(row);
                            <li @key="row.ProbeId"
                                data-probe-binding="@row.Binding"
                                data-probe-pattern="@row.Pattern"
                                data-probe-appearance="@(row.AppearanceOrdinal % 4U)"
                                data-waveform-row-track>
                                <span class="probe-rail" aria-hidden="true"></span>
                                <div class="probe-identity">
                                    <span class="probe-swatch" aria-hidden="true"></span>
                                    <FluentButton Class="probe-label"
                                                  Type="ButtonType.Button"
                                                  Appearance="ButtonAppearance.Transparent"
                                                  Title="@Text["RevealNet"]"
                                                  Disabled="@(row.SceneNavigation != "available")"
                                                  OnClick="@(_ => RevealAsync(row))"><span>@row.ShortLabel</span></FluentButton>
                                    <strong title="@formattedValue">@formattedValue</strong>
                                </div>
                                <div class="probe-controls">
                                    <FluentSelect TOption="string"
                                                  TValue="string"
                                                  aria-label="@Text["Radix"]"
                                                  Size="ListSize.Small"
                                                  Value="@row.Radix"
                                                  ValueChanged="@(value => ChangeRadixAsync(row, value))"
                                                  Disabled="@(row.Binding != "resolved")">
                                        <FluentOptionString Value="binary">@Text["RadixBinary"]</FluentOptionString>
                                        <FluentOptionString Value="hex">@Text["RadixHex"]</FluentOptionString>
                                        <FluentOptionString Value="unsigned">@Text["RadixUnsigned"]</FluentOptionString>
                                    </FluentSelect>
                                    <FluentButton Class="probe-icon-action"
                                                  Type="ButtonType.Button"
                                                  Shape="ButtonShape.Square"
                                                  Size="ButtonSize.Small"
                                                  Appearance="ButtonAppearance.Subtle"
                                                  IconOnly="true"
                                                  Title="@Text["MoveProbeUp"]"
                                                  aria-label="@Text["MoveProbeUp"]"
                                                  Disabled="@(!CanMove(row, -1))"
                                                  OnClick="@(_ => MoveAsync(row, -1))">↑</FluentButton>
                                    <FluentButton Class="probe-icon-action"
                                                  Type="ButtonType.Button"
                                                  Shape="ButtonShape.Square"
                                                  Size="ButtonSize.Small"
                                                  Appearance="ButtonAppearance.Subtle"
                                                  IconOnly="true"
                                                  Title="@Text["MoveProbeDown"]"
                                                  aria-label="@Text["MoveProbeDown"]"
                                                  Disabled="@(!CanMove(row, 1))"
                                                  OnClick="@(_ => MoveAsync(row, 1))">↓</FluentButton>
                                    @if (row.SceneNavigation != "available")
                                    {
                                        <small class="probe-navigation-unavailable">@NavigationMessage(row)</small>
                                    }
                                    @if (CanRebind(row))
                                    {
                                        <FluentButton Type="ButtonType.Button"
                                                      Size="ButtonSize.Small"
                                                      Appearance="ButtonAppearance.Outline"
                                                      Disabled="@(!CanModifyProbes)"
                                                      OnClick="@(_ => RebindAsync(row))">@Text["RebindProbe"]</FluentButton>
                                    }
                                    <FluentButton Class="probe-icon-action"
                                                  Type="ButtonType.Button"
                                                  Shape="ButtonShape.Square"
                                                  Size="ButtonSize.Small"
                                                  Appearance="ButtonAppearance.Subtle"
                                                  IconOnly="true"
                                                  Title="@Text["RemoveProbe"]"
                                                  aria-label="@Text["RemoveProbe"]"
                                                  Disabled="@(row.Binding == "resolved" && !CanModifyProbes)"
                                                  OnClick="@(_ => RemoveAsync(row))">×</FluentButton>
                                </div>
                            </li>
                        }
                    </ol>
                </aside>

                <div class="waveform-frame">
                    <canvas data-waveform-canvas
                            tabindex="0"
                            hidden="@rendererUnavailable"
                            aria-label="@Text["WaveformCanvas"]">
                        @Text["WaveformCanvasFallback"]
                    </canvas>
                    @if (summaryRequested)
                    {
                        <FluentBadge Class="summary-resolution"
                                     Appearance="BadgeAppearance.Outline"
                                     Color="BadgeColor.Subtle"
                                     Size="BadgeSize.Small"
                                     Content="@Text["SummaryResolution"]" />
                    }
                    @if (!liveFollow)
                    {
                        <FluentBadge Class="history-state"
                                     Appearance="BadgeAppearance.Outline"
                                     Color="BadgeColor.Subtle"
                                     Size="BadgeSize.Small"
                                     Content="@Text["HistoricalView"]" />
                    }
                    @if (traceLoading)
                    {
                        <span class="trace-state" role="status">
                            <FluentSpinner Size="SpinnerSize.Tiny" />
                            <span>@Text["LoadingTrace"]</span>
                        </span>
                    }
                    else if (traceFailure is TraceFailure.Evicted or TraceFailure.ArtifactChanged)
                    {
                        <div class="trace-gap-state" role="status">
                            <span>@TraceFailureMessage</span>
                            <FluentButton Type="ButtonType.Button"
                                          Size="ButtonSize.Small"
                                          Appearance="ButtonAppearance.Outline"
                                          OnClick="@(_ => ReturnToLiveAsync())">@Text["ReturnToLive"]</FluentButton>
                        </div>
                    }
                    else if (traceFailure is not null)
                    {
                        <div class="trace-recovery"
                             role="alert"
                             data-browser-policy-id="@browserPolicyEvidence?.PolicyId"
                             data-browser-policy-revision="@browserPolicyEvidence?.PolicyRevision"
                             data-browser-policy-dimension="@browserPolicyEvidence?.DimensionToken"
                             data-browser-policy-observed="@browserPolicyEvidence?.Observed">
                            <FluentMessageBar Class="trace-recovery-message"
                                              AllowDismiss="false"
                                              Intent="MessageBarIntent.Error"
                                              Layout="MessageBarLayout.Notification"
                                              Shape="MessageBarShape.Square">
                                <ChildContent>
                                    <span>@TraceFailureMessage</span>
                                </ChildContent>
                                <ActionsTemplate>
                                    <FluentButton Type="ButtonType.Button"
                                                  Size="ButtonSize.Small"
                                                  Appearance="ButtonAppearance.Primary"
                                                  OnClick="@(_ => RetryAsync())">@Text["RetryWaveform"]</FluentButton>
                                </ActionsTemplate>
                            </FluentMessageBar>
                        </div>
                    }
                </div>
            </div>
        }
    }
</section>
