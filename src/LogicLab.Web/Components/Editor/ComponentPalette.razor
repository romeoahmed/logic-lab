@using LogicLab.Web.Scene

<aside class="component-palette"
       data-testid="component-palette"
       aria-labelledby="component-palette-title">
    <div class="palette-controls" data-testid="component-palette-controls">
        <header>
            <p>@Text["Library"]</p>
            <h2 id="component-palette-title">@Text["Components"]</h2>
        </header>
        <div class="component-search">
            <FluentTextInput data-component-search
                             Label="@Text["SearchComponents"]"
                             Placeholder="@Text["SearchComponentsPlaceholder"]"
                             TextInputType="TextInputType.Search"
                             Size="TextInputSize.Small"
                             Immediate="true"
                             Width="100%"
                             @bind-Value="SearchTerm" />
        </div>
    </div>
    @{ var groups = BuildGroups(); }
    @if (groups.Count == 0)
    {
        <p class="component-empty" role="status">@Text["NoMatchingComponents"]</p>
    }
    else
    {
        <div class="component-groups">
            @foreach (var group in groups)
            {
                <details @key="group.Id" open="@(group.ExpandedByDefault || HasSearchTerm)">
                    <summary>
                        <span>@Text[group.ResourceKey]</span>
                        <small>@group.Options.Count</small>
                    </summary>
                    <div>
                        @foreach (var option in group.Options)
                        {
                            <button type="button"
                                    @key="option.Id"
                                    data-place-option="@option.Id"
                                    disabled="@Disabled"
                                    aria-pressed="@(IsActive(option) ? "true" : "false")"
                                    @onclick="@(() => SelectAsync(option))">
                                <ComponentSymbol ContractId="@SymbolContractId(option)" />
                                <span class="component-copy">
                                    <strong>@DisplayName(option)</strong>
                                    <small>@ComponentHint(option)</small>
                                </span>
                            </button>
                        }
                    </div>
                </details>
            }
        </div>
    }
</aside>
