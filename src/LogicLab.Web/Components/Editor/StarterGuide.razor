<section class="starter-guide" aria-labelledby="starter-guide-title">
    <header>
        <p>@Text["StarterEyebrow"]</p>
        <h2 id="starter-guide-title">@Text["StarterTitle"]</h2>
        <span>@Text["StarterDescription"]</span>
    </header>
    <ol>
        <li><strong>1</strong><span>@Text["LearningStepChoose"]</span></li>
        <li><strong>2</strong><span>@Text["LearningStepCompile"]</span></li>
        <li><strong>3</strong><span>@Text["LearningStepSimulate"]</span></li>
        <li><strong>4</strong><span>@Text["LearningStepObserve"]</span></li>
    </ol>
    <div class="starter-options">
        @foreach (var option in Options)
        {
            <FluentCompoundButton Class="starter-option"
                                  Appearance="ButtonAppearance.Outline"
                                  Size="ButtonSize.Large"
                                  @key="option.Example"
                                  data-command="@option.Command"
                                  Disabled="@(BusyCommand is not null)"
                                  OnClick="@(() => OnSelect.InvokeAsync(option.Example))">
                <span class="starter-option-content">
                    <span class="starter-symbol">
                        <ComponentSymbol ContractId="@option.SymbolContractId" />
                    </span>
                    <span class="starter-copy">
                        <strong>@Text[option.TitleResourceKey]</strong>
                        <small>@Text[option.DescriptionResourceKey]</small>
                    </span>
                </span>
            </FluentCompoundButton>
        }
    </div>
</section>

@code {
    private static readonly StarterOption[] Options =
    [
        new(Example.Inverter, "author", "logic.not", "StarterInverterTitle", "StarterInverterDescription"),
        new(Example.Steering, "author-steering", "logic.mux", "StarterSteeringTitle", "StarterSteeringDescription"),
        new(Example.CarryLookahead, "author-carry-lookahead", "logic.adder", "StarterCarryLookaheadTitle", "StarterCarryLookaheadDescription"),
        new(Example.BitSerial, "author-bit-serial", "sequential.shift_register", "StarterBitSerialTitle", "StarterBitSerialDescription"),
    ];

    [Parameter]
    public string? BusyCommand { get; set; }

    [Parameter]
    public EventCallback<Example> OnSelect { get; set; }

    [Inject]
    private IStringLocalizer<EditorText> Text { get; set; } = null!;

    public enum Example
    {
        Inverter,
        Steering,
        CarryLookahead,
        BitSerial,
    }

    private sealed record StarterOption(
        Example Example,
        string Command,
        string SymbolContractId,
        string TitleResourceKey,
        string DescriptionResourceKey);
}
