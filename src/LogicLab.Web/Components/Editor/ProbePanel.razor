@inject IStringLocalizer<EditorText> Text

<aside class="probe-panel" aria-labelledby="probe-panel-heading">
    <header class="probe-heading">
        <div>
            <p class="eyebrow">@Text["Simulation"]</p>
            <h2 id="probe-panel-heading">@Text["InstrumentBay"]</h2>
        </div>
        <span>@Text["LiveReadout"]</span>
    </header>
    @if (Simulation is null)
    {
        <div class="probe-empty" role="status">
            <span aria-hidden="true"></span>
            <p>@Text["NoActiveSession"]</p>
            <small>@Text["ProbeEmptyHelp"]</small>
        </div>
    }
    else
    {
        <dl>
            <div>
                <dt>@Text["LogicalTime"]</dt>
                <dd>@Simulation.LogicalTime</dd>
            </div>
            <div>
                <dt>@Text["SessionVersion"]</dt>
                <dd>@Simulation.SessionVersion</dd>
            </div>
        </dl>
        <ul aria-label="@Text["ObservedProbesAriaLabel"]">
            @for (var index = 0; index < Simulation.Probes.Count; index++)
            {
                var probe = Simulation.Probes[index];
                <li @key="probe.ProbeId" data-probe="@probe.ProbeId.Value">
                    <span>@ProbeLabel(probe, index)</span>
                    <strong>@Format(probe.Value)</strong>
                </li>
            }
        </ul>
    }
</aside>

@code {
    [Parameter]
    public SimulationProjection? Simulation { get; set; }

    [Parameter, EditorRequired]
    public ProjectRevision? ProjectRevision { get; set; }

    private string ProbeLabel(ProbeProjection probe, int ordinal)
    {
        if (ProjectRevision is not { } revision
            || probe.Source.Identity is not NetSourceIdentity source
            || revision.Document.FindCircuitDefinition(source.CircuitDefinitionId)
                is not { } definition
            || definition.FindNet(source.NetId) is not { } net)
        {
            return Text["SignalOrdinal", ordinal + 1];
        }

        var boundaryPorts = net.Terminals
            .OfType<DefinitionTerminalReference>()
            .Select(terminal => definition.FindPort(terminal.DefinitionPortId))
            .OfType<DefinitionPort>()
            .ToArray();
        var outputPort = boundaryPorts.FirstOrDefault(port =>
            port.Direction == PortDirection.Output);
        if (outputPort is not null)
        {
            return outputPort.DisplayName;
        }

        var boundaryComponents = net.Terminals
            .OfType<InstanceTerminalReference>()
            .Select(terminal => definition.FindComponentInstance(
                terminal.ComponentInstanceId))
            .OfType<ComponentInstance>()
            .Select(instance => (Instance: instance, Contract: instance.Target
                as LibraryComponentTarget))
            .Where(item => item.Contract is not null)
            .ToArray();
        var output = boundaryComponents.FirstOrDefault(item =>
            item.Contract!.ContractKey.ContractId == "sink.output").Instance;
        if (output is not null)
        {
            return output.DisplayName ?? Text["ComponentOutput"];
        }

        var inputPort = boundaryPorts.FirstOrDefault(port =>
            port.Direction == PortDirection.Input);
        if (inputPort is not null)
        {
            return inputPort.DisplayName;
        }

        var input = boundaryComponents.FirstOrDefault(item =>
            item.Contract!.ContractKey.ContractId == "source.input").Instance;
        return input is not null
            ? input.DisplayName ?? Text["ComponentInput"]
            : Text["SignalOrdinal", ordinal + 1];
    }

    private static string Format(IEnumerable<LogicValue> values)
    {
        return string.Concat(values.Select(value => value switch
        {
            LogicValue.Zero => "0",
            LogicValue.One => "1",
            LogicValue.X => "X",
            LogicValue.Z => "Z",
            _ => "?",
        }));
    }
}
