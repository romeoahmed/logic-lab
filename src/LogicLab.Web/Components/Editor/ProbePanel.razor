@inject IStringLocalizer<EditorText> Text

<aside class="probe-panel" aria-labelledby="probe-panel-heading">
    <header class="probe-heading">
        <div>
            <p class="eyebrow">@Text["InstrumentBay"]</p>
            <h2 id="probe-panel-heading">@Text["Probe"]</h2>
        </div>
        <span>@Text["LiveReadout"]</span>
    </header>
    @if (Simulation is null)
    {
        <div class="probe-empty" role="status">
            <span aria-hidden="true"></span>
            <p>@Text["NoActiveSession"]</p>
            <small>@Text["ProbeEmptyHelp"]</small>
        </div>
    }
    else
    {
        <dl>
            <div>
                <dt>@Text["LogicalTime"]</dt>
                <dd>@Simulation.LogicalTime</dd>
            </div>
            <div>
                <dt>@Text["SessionVersion"]</dt>
                <dd>@Simulation.SessionVersion</dd>
            </div>
        </dl>
        <ul aria-label="@Text["ObservedProbesAriaLabel"]">
            @foreach (var probe in Simulation.Probes)
            {
                <li @key="probe.ProbeId" data-probe="@probe.ProbeId.Value">
                    <span>@Text["Output"]</span>
                    <strong>@Format(probe.Value)</strong>
                </li>
            }
        </ul>
    }
</aside>

@code {
    [Parameter]
    public SimulationProjection? Simulation { get; set; }

    private static string Format(IEnumerable<LogicValue> values)
    {
        return string.Concat(values.Select(value => value switch
        {
            LogicValue.Zero => "0",
            LogicValue.One => "1",
            LogicValue.X => "X",
            LogicValue.Z => "Z",
            _ => "?",
        }));
    }
}
