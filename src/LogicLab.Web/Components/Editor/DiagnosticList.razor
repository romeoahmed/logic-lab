<section class="diagnostics" data-diagnostics aria-labelledby="diagnostics-heading">
    <header>
        <h2 id="diagnostics-heading">@Text["Diagnostics"]</h2>
        <p>@Text["DiagnosticCount", count]</p>
    </header>
    @if (count == 0)
    {
        <p class="diagnostic-empty">@Text[Projection.Compilation is CompilationNotRequestedProjection
            ? "DiagnosticCompileFirst" : "DiagnosticEmpty"]</p>
    }
    else
    {
        <FluentDataGrid Items="rows" Pagination="pagination" MultiLine="true"
                        GridTemplateColumns="minmax(0, 1fr)" GenerateHeader="DataGridGeneratedHeaderType.None">
            <TemplateColumn Context="row">
                <article class="diagnostic-item" data-diagnostic-code="@row.Code" data-diagnostic-severity="@row.Severity">
                    <div class="diagnostic-caption">
                        <span class="diagnostic-severity">@Text["DiagnosticSeverity_" + row.Severity]</span>
                        <span>@row.Origin</span>
                    </div>
                    <p class="diagnostic-message">@DiagnosticPresentation.Message(Text, row.Code)</p>
                    @if (row.Source is { } source)
                    {
                        <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small"
                                      data-diagnostic-reveal Disabled="@(!CanReveal(row, source))"
                                      OnClick="@(() => RevealAsync(row, source))">@SourceLabel(row, source)</FluentButton>
                    }
                    <details>
                        <summary>@Text["DiagnosticDetails"]</summary>
                        <code>@row.Code</code>
                        <p>@Text["DiagnosticRevision"]: <code>@row.RevisionId.Value</code></p>
                        @if (row.Arguments.Count != 0)
                        {
                            <dl>
                                @foreach (var argument in row.Arguments)
                                {
                                    <div><dt>@argument.Name</dt><dd>@argument.Value</dd></div>
                                }
                            </dl>
                        }
                        @foreach (var related in row.Related)
                        {
                            <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small"
                                          Disabled="@(!CanReveal(row, related))"
                                          OnClick="@(() => RevealAsync(row, related))">@SourceLabel(row, related)</FluentButton>
                        }
                    </details>
                </article>
            </TemplateColumn>
        </FluentDataGrid>
        @if (count > pagination.ItemsPerPage)
        {
            <FluentPaginator State="pagination">
                <SummaryTemplate>@Text["DiagnosticCount", count]</SummaryTemplate>
                <PaginationTextTemplate>@Text["DiagnosticPage", pagination.CurrentPageIndex + 1, (count - 1) / pagination.ItemsPerPage + 1]</PaginationTextTemplate>
            </FluentPaginator>
        }
    }
</section>
