<button type="button"
        @ref="buttonElement"
        class="scene-action"
        data-scene-source="@Source.Key"
        data-scene-selected="@(Selected ? "true" : null)"
        aria-keyshortcuts="Enter Shift+Enter Control+Enter Meta+Enter"
        @attributes="NavigationAttributes"
        @onfocus="@(() => OnFocus.InvokeAsync(Source))"
        @onclick="ActivateAsync">
    @ChildContent
</button>
