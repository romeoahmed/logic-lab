@using LogicLab.Web.Scene
@implements IAsyncDisposable

<section @key="rendererGeneration"
         class="circuit-scene-shell"
         aria-labelledby="circuit-canvas-heading"
         data-scene-renderer="@rendererState"
         data-scene-diagnostics="@ProjectionDiagnosticCodes"
         data-scene-generation="@rendererGeneration"
         data-scene-selection-count="@(Selection?.Sources.Count ?? 0)"
         @ref="hostElement">
    <div class="scene-heading">
        <div>
            <p class="eyebrow">@Text["CircuitSceneEyebrow"]</p>
            <h2 id="circuit-canvas-heading">@Definition.DisplayName</h2>
        </div>
        <FluentBadge Appearance="BadgeAppearance.Outline"
                     Color="BadgeColor.Subtle"
                     Size="BadgeSize.Small"
                     Content="@Text["SceneCount", Definition.ComponentInstances.Count, Definition.Nets.Count]" />
    </div>

    <div class="canvas-frame">
        <canvas class="scene-canvas"
                data-scene-canvas
                tabindex="0"
                hidden="@(rendererState == RendererUnavailableState)"
                aria-labelledby="circuit-canvas-heading">
            <span>@Text["CircuitCanvasFallback"]</span>
        </canvas>

        <div class="scene-zoom-controls">
            <FluentButton data-scene-zoom="out"
                          Type="ButtonType.Button"
                          Shape="ButtonShape.Square"
                          Appearance="ButtonAppearance.Subtle"
                          IconOnly="true"
                          Title="@Text["ZoomOut"]">−</FluentButton>
            <FluentButton data-scene-zoom="fit"
                          Type="ButtonType.Button"
                          Shape="ButtonShape.Square"
                          Appearance="ButtonAppearance.Subtle"
                          IconOnly="true"
                          Title="@Text["ZoomToFit"]">□</FluentButton>
            <FluentButton data-scene-zoom="in"
                          Type="ButtonType.Button"
                          Shape="ButtonShape.Square"
                          Appearance="ButtonAppearance.Subtle"
                          IconOnly="true"
                          Title="@Text["ZoomIn"]">+</FluentButton>
        </div>

        @if (rendererState != RendererReadyState)
        {
            <div class="renderer-recovery"
                 data-scene-recovery="@failureCode"
                 data-browser-policy-id="@browserPolicyEvidence?.PolicyId"
                 data-browser-policy-revision="@browserPolicyEvidence?.PolicyRevision"
                 data-browser-policy-dimension="@browserPolicyEvidence?.DimensionToken"
                 data-browser-policy-observed="@browserPolicyEvidence?.Observed">
                <FluentMessageBar Class="renderer-message"
                                  AllowDismiss="false"
                                  Intent="@RendererIntent"
                                  Layout="MessageBarLayout.Notification"
                                  Shape="MessageBarShape.Square">
                    <ChildContent>
                        @if (rendererState != RendererUnavailableState)
                        {
                            <FluentSpinner Size="SpinnerSize.Small" />
                        }
                        <span>@RendererMessage</span>
                    </ChildContent>
                    <ActionsTemplate>
                        @if (rendererState == RendererUnavailableState)
                        {
                            <FluentButton data-scene-retry
                                          Type="ButtonType.Button"
                                          Size="ButtonSize.Small"
                                          Appearance="ButtonAppearance.Primary"
                                          OnClick="@(_ => RetryAsync())">@Text["RetryCanvas"]</FluentButton>
                        }
                    </ActionsTemplate>
                </FluentMessageBar>
            </div>
        }
    </div>
</section>
