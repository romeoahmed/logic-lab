@using LogicLab.Web.Scene
@implements IAsyncDisposable

<section @key="rendererGeneration"
         class="circuit-scene-shell"
         aria-labelledby="circuit-canvas-heading"
         data-scene-renderer="@rendererState"
         data-scene-generation="@rendererGeneration"
         data-scene-selection-count="@(Selection?.Sources.Count ?? 0)"
         @ref="hostElement">
    <div class="scene-heading">
        <div>
            <p class="eyebrow">@Text["CircuitSceneEyebrow"]</p>
            <h2 id="circuit-canvas-heading">@(Scene?.DisplayName ?? Text["Circuit"])</h2>
        </div>
        @if (Scene is not null)
        {
            <span class="scene-count">@Text["SceneCount", Scene.Components.Count, Scene.Connections.Count]</span>
        }
    </div>

    <div class="canvas-frame">
        <canvas class="scene-canvas"
                data-scene-canvas
                tabindex="0"
                hidden="@(rendererState == RendererUnavailableState)"
                aria-label="@Text["CircuitCanvasAriaLabel"]"
                aria-describedby="scene-renderer-status">
            @if (rendererState != RendererUnavailableState)
            {
                <AccessibleCircuitScene Scene="Scene"
                                        ShowHeading="false"
                                        HeadingId="semantic-circuit-heading"
                                        PageSize="SemanticPageSize"
                                        OnSelect="HandleSemanticSelectionAsync"
                                        OnFocus="HandleSemanticFocusAsync"
                                        OnAction="HandleSemanticActionAsync" />
            }
        </canvas>

        <div class="scene-zoom-controls"
             role="group"
             aria-label="@Text["CanvasZoomControls"]">
            <button type="button"
                    data-scene-zoom="out"
                    title="@Text["ZoomOut"]"
                    aria-label="@Text["ZoomOut"]">−</button>
            <button type="button"
                    data-scene-zoom="fit"
                    title="@Text["ZoomToFit"]"
                    aria-label="@Text["ZoomToFit"]">□</button>
            <button type="button"
                    data-scene-zoom="in"
                    title="@Text["ZoomIn"]"
                    aria-label="@Text["ZoomIn"]">+</button>
        </div>

        @if (rendererState != RendererReadyState)
        {
            <div class="renderer-recovery"
                 role="status"
                 data-scene-recovery="@failureCode"
                 data-browser-policy-id="@browserPolicyEvidence?.PolicyId"
                 data-browser-policy-revision="@browserPolicyEvidence?.PolicyRevision"
                 data-browser-policy-dimension="@browserPolicyEvidence?.DimensionToken"
                 data-browser-policy-observed="@browserPolicyEvidence?.Observed">
                <p>@RendererMessage</p>
                @if (rendererState == RendererUnavailableState)
                {
                    <button type="button" @onclick="RetryAsync">@Text["RetryCanvas"]</button>
                }
            </div>
        }
    </div>

    <p id="scene-renderer-status" class="visually-hidden" aria-live="polite">@RendererMessage</p>

    @if (rendererState == RendererUnavailableState)
    {
        <details class="semantic-scene" open>
            <summary>@Text["SemanticCircuitOutline"]</summary>
            <AccessibleCircuitScene Scene="Scene"
                                    ShowHeading="false"
                                    HeadingId="semantic-circuit-heading"
                                    PageSize="SemanticPageSize"
                                    OnSelect="HandleSemanticSelectionAsync"
                                    OnFocus="HandleSemanticFocusAsync"
                                    OnAction="HandleSemanticActionAsync" />
        </details>
    }
</section>
