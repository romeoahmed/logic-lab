@inject IStringLocalizer<EditorText> Text

<section class="definition-navigator">
    <header class="definition-navigator-heading">
        <p>@Text["DefinitionContext"]</p>
        <span>@Text["TabsHierarchyEntry"]</span>
    </header>
    <div class="definition-navigator-content">
        @if (Document is null || SelectedDefinitionId is null)
        {
            <div class="navigator-empty" role="status">
                <span aria-hidden="true"><i></i><i></i><i></i></span>
                <p>@Text["NoDefinitions"]</p>
            </div>
        }
        else
        {
            <nav class="definition-tabs">
                @foreach (var definition in Document.CircuitDefinitions
                    .OrderBy(item => item.DisplayName, StringComparer.Ordinal)
                    .ThenBy(item => item.Id.Value, StringComparer.Ordinal))
                {
                    <FluentButton @key="definition.Id"
                                  data-definition="@definition.Id.Value"
                                  Size="ButtonSize.Small"
                                  Appearance="@(definition.Id == SelectedDefinitionId ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                                  aria-current="@(definition.Id == SelectedDefinitionId ? "page" : null)"
                                  OnClick="@(() => OnSelect.InvokeAsync(definition.Id))">
                        @definition.DisplayName
                        @if (definition.Id == Document.EntryCircuitDefinitionId)
                        {
                            <span data-entry-marker title="@Text["EntryCircuitDefinition"]">@Text["Entry"]</span>
                        }
                    </FluentButton>
                }
            </nav>

            <div class="hierarchy-row">
                <nav>
                    <ol data-hierarchy-breadcrumb>
                        @foreach (var breadcrumb in Breadcrumbs)
                        {
                            <li @key="breadcrumb.Key">@breadcrumb.Label</li>
                        }
                    </ol>
                </nav>
                <span class="view-kind">@(IsOccurrence ? Text["ElaboratedOccurrence"] : Text["DefinitionView"])</span>
                @if (IsOccurrence)
                {
                    <FluentButton data-command="hierarchy-back"
                                  Size="ButtonSize.Small"
                                  Appearance="ButtonAppearance.Outline"
                                  OnClick="OnBack">@Text["Back"]</FluentButton>
                }
                @if (SelectedDefinitionId != Document.EntryCircuitDefinitionId)
                {
                    <FluentButton data-command="set-entry"
                                  Size="ButtonSize.Small"
                                  Appearance="ButtonAppearance.Outline"
                                  Disabled="@(!CanSetEntry)"
                                  OnClick="@(() => OnSetEntry.InvokeAsync(SelectedDefinitionId))">
                        @Text["SetAsEntry"]
                    </FluentButton>
                }
            </div>

            @if (CanEnterOccurrences && SelectedDefinition is { } selected)
            {
                var calls = selected.ComponentInstances
                    .Where(instance => instance.Target is CircuitDefinitionComponentTarget)
                    .OrderBy(instance => instance.Id.Value, StringComparer.Ordinal)
                    .ToArray();
                @if (calls.Length != 0)
                {
                    <div class="occurrence-links">
                        @foreach (var call in calls)
                        {
                            <FluentButton @key="call.Id"
                                          data-enter-instance="@call.Id.Value"
                                          Size="ButtonSize.Small"
                                          Appearance="ButtonAppearance.Subtle"
                                          OnClick="@(() => OnEnter.InvokeAsync(call.Id))">
                                @Text["EnterDefinition", call.DisplayName ?? Text["CircuitDefinitionInstance"]]
                            </FluentButton>
                        }
                    </div>
                }
            }
        }
    </div>
</section>

@code {
    [Parameter]
    public ProjectDocument? Document { get; set; }

    [Parameter]
    public CircuitDefinitionId? SelectedDefinitionId { get; set; }

    [Parameter]
    public IReadOnlyList<HierarchyBreadcrumbItem> Breadcrumbs { get; set; } = [];

    [Parameter]
    public bool IsOccurrence { get; set; }

    [Parameter]
    public bool CanSetEntry { get; set; }

    [Parameter]
    public bool CanEnterOccurrences { get; set; }

    [Parameter]
    public EventCallback<CircuitDefinitionId> OnSelect { get; set; }

    [Parameter]
    public EventCallback<CircuitDefinitionId> OnSetEntry { get; set; }

    [Parameter]
    public EventCallback<ComponentInstanceId> OnEnter { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    private CircuitDefinition? SelectedDefinition =>
        Document is null || SelectedDefinitionId is null
            ? null
            : Document.FindCircuitDefinition(SelectedDefinitionId);
}
