<section class="topology-command-panel" aria-labelledby="topology-command-heading">
    <div class="topology-command-heading">
        <div>
            <p class="topology-eyebrow">Explicit topology</p>
            <h2 id="topology-command-heading">Net and route editing</h2>
        </div>
        <small>Geometry never creates electrical membership.</small>
    </div>
    <div class="topology-command-bar" role="group" aria-label="Topology commands">
        <div class="topology-command-group" role="group" aria-label="Electrical membership">
            <span>Membership</span>
            <div>
                <FluentButton data-command="topology-merge"
                              Appearance="ButtonAppearance.Outline"
                              Disabled="@(!CanMerge || BlocksCommittedCommands)"
                              Loading="@(ActiveCommand is "topology-merge")"
                              OnClick="OnMerge">Merge Nets</FluentButton>
                <FluentButton data-command="topology-split"
                              Appearance="ButtonAppearance.Outline"
                              Disabled="@(!CanSplit || BlocksCommittedCommands)"
                              Loading="@(ActiveCommand is "topology-split")"
                              OnClick="OnSplit">Split Net</FluentButton>
            </div>
        </div>
        <div class="topology-command-group" role="group" aria-label="Junction editing">
            <span>Junctions</span>
            <div>
                <FluentButton data-command="topology-add-junction"
                              Appearance="ButtonAppearance.Subtle"
                              Disabled="@(!CanAddJunction || BlocksCommittedCommands)"
                              Loading="@(ActiveCommand is "topology-add-junction")"
                              OnClick="OnAddJunction">Add</FluentButton>
                <FluentButton data-command="topology-remove-junction"
                              Appearance="ButtonAppearance.Subtle"
                              Disabled="@(!CanRemoveJunction || BlocksCommittedCommands)"
                              Loading="@(ActiveCommand is "topology-remove-junction")"
                              OnClick="OnRemoveJunction">Remove</FluentButton>
            </div>
        </div>
        <div class="topology-command-group" role="group" aria-label="Route geometry">
            <span>Geometry</span>
            <div>
                <FluentButton data-command="topology-prepare-route"
                              Appearance="ButtonAppearance.Outline"
                              Disabled="@(!CanPrepareRoute || BlocksCommittedCommands)"
                              OnClick="OnPrepareRoute">Prepare</FluentButton>
                <FluentButton data-command="topology-unroute"
                              Appearance="ButtonAppearance.Subtle"
                              Disabled="@(!CanUnroute || BlocksCommittedCommands)"
                              Loading="@(ActiveCommand is "topology-unroute")"
                              OnClick="OnUnroute">Unroute</FluentButton>
                <FluentButton data-command="topology-route"
                              Appearance="ButtonAppearance.Outline"
                              Disabled="@(!CanRoute || BlocksCommittedCommands)"
                              Loading="@(ActiveCommand is "topology-route")"
                              OnClick="OnRoute">Route</FluentButton>
            </div>
        </div>
        <div class="topology-command-group" role="group" aria-label="Route draft">
            <span>Draft</span>
            <div>
                <FluentButton data-command="topology-commit-route"
                              Appearance="@(RouteDraftActive
                                  ? ButtonAppearance.Primary
                                  : ButtonAppearance.Outline)"
                              Disabled="@(!RouteDraftActive || IsBusy)"
                              Loading="@(ActiveCommand is "topology-commit-route")"
                              OnClick="OnCommitRoute">Commit</FluentButton>
                <FluentButton data-command="topology-cancel-route"
                              Appearance="ButtonAppearance.Subtle"
                              Disabled="@(!RouteDraftActive || IsBusy)"
                              OnClick="OnCancelRoute">Cancel</FluentButton>
            </div>
        </div>
    </div>
    @if (RouteDraftActive)
    {
        <p class="route-draft" data-route-draft role="status">
            Route preview: 0,0 → 0,2 → 8,2. Commit or cancel this local draft.
        </p>
    }
</section>
