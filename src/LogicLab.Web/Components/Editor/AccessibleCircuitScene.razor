@inject IStringLocalizer<EditorText> Text

<section class="scene" aria-labelledby="@HeadingId">
    <div class="scene-heading">
        <div>
            <p class="eyebrow">@Text["CircuitSceneEyebrow"]</p>
            <h2 id="@HeadingId" class="@(!ShowHeading ? "visually-hidden" : null)">@(Scene?.DisplayName ?? Text["Circuit"])</h2>
        </div>
        @if (Scene is not null)
        {
            <span class="scene-count">@Text["SceneCount", Scene.Components.Count, Scene.Connections.Count]</span>
        }
    </div>

    @if (Scene is null)
    {
        <p class="empty-state" role="status">@Text["CreateSandboxToBegin"]</p>
    }
    else if (Scene.Components.Count == 0
        && Scene.DefinitionPorts.Count == 0
        && Scene.Connections.Count == 0
        && Scene.Annotations.Count == 0)
    {
        <p class="empty-state" role="status">@Text["DefinitionReady"]</p>
    }
    else
    {
        @if (totalPages > 1)
        {
            <nav class="semantic-pager" aria-label="@Text["SemanticScenePagesAriaLabel"]">
                <button type="button" disabled="@(pageIndex == 0)" @onclick="PreviousPage">
                    @Text["Previous"]
                </button>
                <span>@Text["SemanticScenePage", pageIndex + 1, totalPages]</span>
                <button type="button" disabled="@(pageIndex + 1 == totalPages)" @onclick="NextPage">
                    @Text["Next"]
                </button>
            </nav>
        }

        @if (Scene.DefinitionPorts.Count != 0)
        {
            <h3 class="definition-ports-heading">@Text["DefinitionPorts"]</h3>
            <ul class="definition-port-list" aria-label="@Text["CircuitDefinitionPortsAriaLabel"]">
                @foreach (var port in Scene.DefinitionPorts.Where(port =>
                    IsVisible(DefinitionPortSource(port))))
                {
                    <li @key="port.Source"
                        data-definition-port="@port.Source.DefinitionPortId.Value">
                        <SceneSourceButton Source="DefinitionPortSource(port)"
                                           Selected="IsSelected(DefinitionPortSource(port))"
                                           RequestFocus="IsPageFocusTarget(DefinitionPortSource(port))"
                                           NavigationAttributes="NavigationAttributes(DefinitionPortSource(port))"
                                           OnFocus="FocusAsync"
                                           OnActivate="ActivateAsync">
                            <strong>@port.Label</strong> · @PortDirectionText(port.Direction) · @Text["PortCount", port.Width]
                            @if (IsSelected(DefinitionPortSource(port)))
                            {
                                <span class="selection-indicator">@Text["Selected"]</span>
                            }
                        </SceneSourceButton>
                        <div class="semantic-actions" aria-label="@Text["Move"]">
                            <SceneNudgeButtons Source="DefinitionPortSource(port)"
                                               Position="port.Placement.Position"
                                               OnAction="OnAction"
                                               OnFocus="OnFocus" />
                        </div>
                    </li>
                }
            </ul>
        }

        <ol class="component-list" aria-label="@Text["CircuitComponentsAriaLabel"]">
            @foreach (var component in Scene.Components.Where(ComponentIsVisible))
            {
                <li @key="component.Source" data-component="@component.Source.ComponentInstanceId.Value">
                    <article class="component-card">
                        @if (IsVisible(ComponentSource(component)))
                        {
                            <h3>
                                <SceneSourceButton Source="ComponentSource(component)"
                                                   Selected="IsSelected(ComponentSource(component))"
                                                   RequestFocus="IsPageFocusTarget(ComponentSource(component))"
                                                   NavigationAttributes="NavigationAttributes(ComponentSource(component))"
                                                   OnFocus="FocusAsync"
                                                   OnActivate="ActivateAsync">
                                    @component.Label
                                    @if (IsSelected(ComponentSource(component)))
                                    {
                                        <span class="selection-indicator">@Text["Selected"]</span>
                                    }
                                </SceneSourceButton>
                            </h3>
                        }
                        else
                        {
                            <h3>@component.Label</h3>
                        }
                        <p>@Text["GridPosition", component.Placement.Origin.X, component.Placement.Origin.Y]</p>
                        @if (IsVisible(ComponentSource(component)))
                        {
                            <div class="semantic-actions" aria-label="@Text["ActionsFor", component.Label]">
                                <SceneNudgeButtons Source="ComponentSource(component)"
                                                   Position="component.Placement.Origin"
                                                   OnAction="OnAction"
                                                   OnFocus="OnFocus" />
                                <button type="button"
                                        data-scene-action="remove"
                                        @onfocus="@(() => FocusAsync(ComponentSource(component)))"
                                        @onclick="@(() => RemoveAsync(ComponentSource(component)))">@Text["Remove"]</button>
                            </div>
                        }
                        <ul aria-label="@Text["PortsAriaLabel", component.Label]">
                            @foreach (var port in component.Ports.Where(port =>
                                IsVisible(InstancePortSource(port))))
                            {
                                <li @key="port.Source">
                                    <SceneSourceButton Source="InstancePortSource(port)"
                                                       Selected="IsSelected(InstancePortSource(port))"
                                                       RequestFocus="IsPageFocusTarget(InstancePortSource(port))"
                                                       NavigationAttributes="NavigationAttributes(InstancePortSource(port))"
                                                       OnFocus="FocusAsync"
                                                       OnActivate="ActivateAsync">
                                        <strong>@port.Label</strong> · @PortDirectionText(port.Direction) · @Text["PortCount", port.Width]
                                        @if (IsSelected(InstancePortSource(port)))
                                        {
                                            <span class="selection-indicator">@Text["Selected"]</span>
                                        }
                                    </SceneSourceButton>
                                </li>
                            }
                        </ul>
                    </article>
                </li>
            }
        </ol>

        @if (Scene.Annotations.Any(annotation => IsVisible(AnnotationSource(annotation))))
        {
            <h3 class="annotations-heading">@Text["Annotations"]</h3>
            <ol class="annotation-list" aria-label="@Text["CircuitAnnotationsAriaLabel"]">
                @foreach (var annotation in Scene.Annotations.Where(annotation =>
                    IsVisible(AnnotationSource(annotation))))
                {
                    <li @key="annotation.Source"
                        data-annotation="@annotation.Source.AnnotationId.Value">
                        <SceneSourceButton Source="AnnotationSource(annotation)"
                                           Selected="IsSelected(AnnotationSource(annotation))"
                                           RequestFocus="IsPageFocusTarget(AnnotationSource(annotation))"
                                           NavigationAttributes="NavigationAttributes(AnnotationSource(annotation))"
                                           OnFocus="FocusAsync"
                                           OnActivate="ActivateAsync">
                            <bdi>@annotation.Text</bdi> · @Text["GridPosition", annotation.Position.X, annotation.Position.Y]
                            @if (IsSelected(AnnotationSource(annotation)))
                            {
                                <span class="selection-indicator">@Text["Selected"]</span>
                            }
                        </SceneSourceButton>
                        <div class="semantic-actions" aria-label="@Text["ActionsFor", annotation.Text]">
                            <SceneNudgeButtons Source="AnnotationSource(annotation)"
                                               Position="annotation.Position"
                                               OnAction="OnAction"
                                               OnFocus="OnFocus" />
                            <button type="button"
                                    data-scene-action="remove"
                                    @onfocus="@(() => FocusAsync(AnnotationSource(annotation)))"
                                    @onclick="@(() => RemoveAsync(AnnotationSource(annotation)))">@Text["Remove"]</button>
                        </div>
                    </li>
                }
            </ol>
        }

        <h3 class="connections-heading">@Text["Connections"]</h3>
        <ol class="connection-list" aria-label="@Text["ElectricalConnectionsAriaLabel"]">
            @foreach (var connection in Scene.Connections.Where(ConnectionIsVisible))
            {
                <li @key="connection.Source" data-connection="@connection.Source.NetId.Value">
                    <div class="connection-summary">
                        <span>
                            @if (IsVisible(NetSource(connection)))
                            {
                                <SceneSourceButton Source="NetSource(connection)"
                                                   Selected="IsSelected(NetSource(connection))"
                                                   RequestFocus="IsPageFocusTarget(NetSource(connection))"
                                                   NavigationAttributes="NavigationAttributes(NetSource(connection))"
                                                   OnFocus="FocusAsync"
                                                   OnActivate="ActivateAsync">
                                    @TerminalPath(Scene, connection)
                                    @if (IsSelected(NetSource(connection)))
                                    {
                                        <span class="selection-indicator">@Text["Selected"]</span>
                                    }
                                </SceneSourceButton>
                            }
                            else
                            {
                                @TerminalPath(Scene, connection)
                            }
                        </span>
                        <small>@Text["PortCount", connection.Width]</small>
                    </div>
                    @if (connection.Junctions.Count != 0 || connection.WireGeometries.Count != 0)
                    {
                        <ul class="topology-list" aria-label="@Text["TopologyForNetAriaLabel", connection.Source.NetId.Value]">
                            @foreach (var junction in connection.Junctions.Where(junction =>
                                IsVisible(JunctionSource(junction))))
                            {
                                <li @key="junction.Source" data-junction="@junction.Source.JunctionId.Value">
                                    <SceneSourceButton Source="JunctionSource(junction)"
                                                       Selected="IsSelected(JunctionSource(junction))"
                                                       RequestFocus="IsPageFocusTarget(JunctionSource(junction))"
                                                       NavigationAttributes="NavigationAttributes(JunctionSource(junction))"
                                                       OnFocus="FocusAsync"
                                                       OnActivate="ActivateAsync">
                                        @Text["JunctionAtGrid", junction.Point.X, junction.Point.Y]
                                        @if (IsSelected(JunctionSource(junction)))
                                        {
                                            <span class="selection-indicator">@Text["Selected"]</span>
                                        }
                                    </SceneSourceButton>
                                </li>
                            }
                            @foreach (var geometry in connection.WireGeometries.Where(geometry =>
                                IsVisible(WireSource(geometry))))
                            {
                                <li @key="geometry.Source" data-wire-geometry="@geometry.Source.WireGeometryId.Value">
                                    <SceneSourceButton Source="WireSource(geometry)"
                                                       Selected="IsSelected(WireSource(geometry))"
                                                       RequestFocus="IsPageFocusTarget(WireSource(geometry))"
                                                       NavigationAttributes="NavigationAttributes(WireSource(geometry))"
                                                       OnFocus="FocusAsync"
                                                       OnActivate="ActivateAsync">
                                        @WireRouteLabel(geometry.Route)
                                        @if (IsSelected(WireSource(geometry)))
                                        {
                                            <span class="selection-indicator">@Text["Selected"]</span>
                                        }
                                    </SceneSourceButton>
                                    <button type="button"
                                            data-scene-action="remove"
                                            @onfocus="@(() => FocusAsync(WireSource(geometry)))"
                                            @onclick="@(() => RemoveAsync(WireSource(geometry)))">@Text["Remove"]</button>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ol>
    }
</section>
