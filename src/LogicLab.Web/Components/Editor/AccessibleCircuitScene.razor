@inject IStringLocalizer<EditorText> Text
@using LogicLab.Web.Scene

<section class="scene" aria-labelledby="@HeadingId">
    <div class="scene-heading">
        <div>
            <p class="eyebrow">@Text["CircuitSceneEyebrow"]</p>
            <h2 id="@HeadingId" class="@(!ShowHeading ? "visually-hidden" : null)">@(Scene?.DisplayName ?? Text["Circuit"])</h2>
        </div>
        @if (Scene is not null)
        {
            <span class="scene-count">@Text["SceneCount", Scene.Components.Count, Scene.Connections.Count]</span>
        }
    </div>

    @if (Scene is null)
    {
        <p class="empty-state" role="status">@Text["CreateSandboxToBegin"]</p>
    }
    else if (Scene.Components.Count == 0
        && Scene.DefinitionPorts.Count == 0
        && Scene.Connections.Count == 0
        && Scene.Annotations.Count == 0)
    {
        <p class="empty-state" role="status">@Text["DefinitionReady"]</p>
    }
    else
    {
        @if (totalPages > 1)
        {
            <nav class="semantic-pager" aria-label="@Text["SemanticScenePagesAriaLabel"]">
                <button type="button" disabled="@(pageIndex == 0)" @onclick="PreviousPageAsync">
                    @Text["Previous"]
                </button>
                <span>@Text["SemanticScenePage", pageIndex + 1, totalPages]</span>
                <button type="button" disabled="@(pageIndex + 1 == totalPages)" @onclick="NextPageAsync">
                    @Text["Next"]
                </button>
            </nav>
        }

        @if (Scene.DefinitionPorts.Count != 0)
        {
            <h3 class="definition-ports-heading">@Text["DefinitionPorts"]</h3>
            <ul class="definition-port-list" aria-label="@Text["CircuitDefinitionPortsAriaLabel"]">
                @foreach (var port in Scene.DefinitionPorts.Where(port =>
                    IsVisible(DefinitionPortSource(port))))
                {
                    <li @key="port.Source"
                        data-definition-port="@port.Source.DefinitionPortId.Value">
                        <button type="button"
                                class="scene-action"
                                data-scene-source="@DefinitionPortSource(port).Key"
                                data-scene-selected="@(IsSelected(DefinitionPortSource(port)) ? "true" : null)"
                                @attributes="NavigationAttributes(DefinitionPortSource(port))"
                                @onfocus="@(() => FocusAsync(DefinitionPortSource(port)))"
                                @onclick="@(() => ActivateAsync(DefinitionPortSource(port)))">
                            <strong>@port.Label</strong> · @PortDirectionText(port.Direction) · @Text["PortCount", port.Width]
                            @if (IsSelected(DefinitionPortSource(port)))
                            {
                                <span class="selection-indicator">@Text["Selected"]</span>
                            }
                        </button>
                        <div class="semantic-actions" aria-label="@Text["Move"]">
                            <SceneNudgeButtons Source="DefinitionPortSource(port)"
                                               Position="port.Placement.Position"
                                               OnAction="OnAction"
                                               OnFocus="OnFocus" />
                        </div>
                    </li>
                }
            </ul>
        }

        <ol class="component-list" aria-label="@Text["CircuitComponentsAriaLabel"]">
            @foreach (var component in Scene.Components.Where(ComponentIsVisible))
            {
                <li @key="component.Source" data-component="@component.Source.ComponentInstanceId.Value">
                    <article class="component-card">
                        @if (IsVisible(ComponentSource(component)))
                        {
                            <h3>
                                <button type="button"
                                        class="scene-action"
                                        data-scene-source="@ComponentSource(component).Key"
                                        data-scene-selected="@(IsSelected(ComponentSource(component)) ? "true" : null)"
                                        @attributes="NavigationAttributes(ComponentSource(component))"
                                        @onfocus="@(() => FocusAsync(ComponentSource(component)))"
                                        @onclick="@(() => ActivateAsync(ComponentSource(component)))">
                                    @component.Label
                                    @if (IsSelected(ComponentSource(component)))
                                    {
                                        <span class="selection-indicator">@Text["Selected"]</span>
                                    }
                                </button>
                            </h3>
                        }
                        else
                        {
                            <h3>@component.Label</h3>
                        }
                        <p>@Text["GridPosition", component.Placement.Origin.X, component.Placement.Origin.Y]</p>
                        @if (IsVisible(ComponentSource(component)))
                        {
                            <div class="semantic-actions" aria-label="@Text["ActionsFor", component.Label]">
                                <SceneNudgeButtons Source="ComponentSource(component)"
                                                   Position="component.Placement.Origin"
                                                   OnAction="OnAction"
                                                   OnFocus="OnFocus" />
                                <button type="button"
                                        data-scene-action="remove"
                                        @onfocus="@(() => FocusAsync(ComponentSource(component)))"
                                        @onclick="@(() => RemoveAsync(ComponentSource(component)))">@Text["Remove"]</button>
                            </div>
                        }
                        <ul aria-label="@Text["PortsAriaLabel", component.Label]">
                            @foreach (var port in component.Ports.Where(port =>
                                IsVisible(InstancePortSource(port))))
                            {
                                <li @key="port.Source">
                                    <button type="button"
                                            class="scene-action"
                                            data-scene-source="@InstancePortSource(port).Key"
                                            data-scene-selected="@(IsSelected(InstancePortSource(port)) ? "true" : null)"
                                            @attributes="NavigationAttributes(InstancePortSource(port))"
                                            @onfocus="@(() => FocusAsync(InstancePortSource(port)))"
                                            @onclick="@(() => ActivateAsync(InstancePortSource(port)))">
                                        <strong>@port.Label</strong> · @PortDirectionText(port.Direction) · @Text["PortCount", port.Width]
                                        @if (IsSelected(InstancePortSource(port)))
                                        {
                                            <span class="selection-indicator">@Text["Selected"]</span>
                                        }
                                    </button>
                                </li>
                            }
                        </ul>
                    </article>
                </li>
            }
        </ol>

        @if (Scene.Annotations.Any(annotation => IsVisible(AnnotationSource(annotation))))
        {
            <h3 class="annotations-heading">@Text["Annotations"]</h3>
            <ol class="annotation-list" aria-label="@Text["CircuitAnnotationsAriaLabel"]">
                @foreach (var annotation in Scene.Annotations.Where(annotation =>
                    IsVisible(AnnotationSource(annotation))))
                {
                    <li @key="annotation.Source"
                        data-annotation="@annotation.Source.AnnotationId.Value">
                        <button type="button"
                                class="scene-action"
                                data-scene-source="@AnnotationSource(annotation).Key"
                                data-scene-selected="@(IsSelected(AnnotationSource(annotation)) ? "true" : null)"
                                @attributes="NavigationAttributes(AnnotationSource(annotation))"
                                @onfocus="@(() => FocusAsync(AnnotationSource(annotation)))"
                                @onclick="@(() => ActivateAsync(AnnotationSource(annotation)))">
                            <bdi>@annotation.Text</bdi> · @Text["GridPosition", annotation.Position.X, annotation.Position.Y]
                            @if (IsSelected(AnnotationSource(annotation)))
                            {
                                <span class="selection-indicator">@Text["Selected"]</span>
                            }
                        </button>
                        <div class="semantic-actions" aria-label="@Text["ActionsFor", annotation.Text]">
                            <SceneNudgeButtons Source="AnnotationSource(annotation)"
                                               Position="annotation.Position"
                                               OnAction="OnAction"
                                               OnFocus="OnFocus" />
                            <button type="button"
                                    data-scene-action="remove"
                                    @onfocus="@(() => FocusAsync(AnnotationSource(annotation)))"
                                    @onclick="@(() => RemoveAsync(AnnotationSource(annotation)))">@Text["Remove"]</button>
                        </div>
                    </li>
                }
            </ol>
        }

        <h3 class="connections-heading">@Text["Connections"]</h3>
        <ol class="connection-list" aria-label="@Text["ElectricalConnectionsAriaLabel"]">
            @foreach (var connection in Scene.Connections.Where(ConnectionIsVisible))
            {
                <li @key="connection.Source" data-connection="@connection.Source.NetId.Value">
                    <div class="connection-summary">
                        <span>
                            @if (IsVisible(NetSource(connection)))
                            {
                                <button type="button"
                                        class="scene-action"
                                        data-scene-source="@NetSource(connection).Key"
                                        data-scene-selected="@(IsSelected(NetSource(connection)) ? "true" : null)"
                                        @attributes="NavigationAttributes(NetSource(connection))"
                                        @onfocus="@(() => FocusAsync(NetSource(connection)))"
                                        @onclick="@(() => ActivateAsync(NetSource(connection)))">
                                    @TerminalPath(Scene, connection)
                                    @if (IsSelected(NetSource(connection)))
                                    {
                                        <span class="selection-indicator">@Text["Selected"]</span>
                                    }
                                </button>
                            }
                            else
                            {
                                @TerminalPath(Scene, connection)
                            }
                        </span>
                        <small>@Text["PortCount", connection.Width]</small>
                    </div>
                    @if (connection.Junctions.Count != 0 || connection.WireGeometries.Count != 0)
                    {
                        <ul class="topology-list" aria-label="@Text["TopologyForNetAriaLabel", connection.Source.NetId.Value]">
                            @foreach (var junction in connection.Junctions.Where(junction =>
                                IsVisible(JunctionSource(junction))))
                            {
                                <li @key="junction.Source" data-junction="@junction.Source.JunctionId.Value">
                                    <button type="button"
                                            class="scene-action"
                                            data-scene-source="@JunctionSource(junction).Key"
                                            data-scene-selected="@(IsSelected(JunctionSource(junction)) ? "true" : null)"
                                            @attributes="NavigationAttributes(JunctionSource(junction))"
                                            @onfocus="@(() => FocusAsync(JunctionSource(junction)))"
                                            @onclick="@(() => ActivateAsync(JunctionSource(junction)))">
                                        @Text["JunctionAtGrid", junction.Point.X, junction.Point.Y]
                                        @if (IsSelected(JunctionSource(junction)))
                                        {
                                            <span class="selection-indicator">@Text["Selected"]</span>
                                        }
                                    </button>
                                </li>
                            }
                            @foreach (var geometry in connection.WireGeometries.Where(geometry =>
                                IsVisible(WireSource(geometry))))
                            {
                                <li @key="geometry.Source" data-wire-geometry="@geometry.Source.WireGeometryId.Value">
                                    <button type="button"
                                            class="scene-action"
                                            data-scene-source="@WireSource(geometry).Key"
                                            data-scene-selected="@(IsSelected(WireSource(geometry)) ? "true" : null)"
                                            @attributes="NavigationAttributes(WireSource(geometry))"
                                            @onfocus="@(() => FocusAsync(WireSource(geometry)))"
                                            @onclick="@(() => ActivateAsync(WireSource(geometry)))">
                                        @WireRouteLabel(geometry.Route)
                                        @if (IsSelected(WireSource(geometry)))
                                        {
                                            <span class="selection-indicator">@Text["Selected"]</span>
                                        }
                                    </button>
                                    <button type="button"
                                            data-scene-action="remove"
                                            @onfocus="@(() => FocusAsync(WireSource(geometry)))"
                                            @onclick="@(() => RemoveAsync(WireSource(geometry)))">@Text["Remove"]</button>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter]
    public AccessibleSceneProjection? Scene { get; set; }

    [Parameter]
    public bool ShowHeading { get; set; } = true;

    [Parameter]
    public string HeadingId { get; set; } = "circuit-scene-heading";

    [Parameter]
    public EventCallback<SceneSelectionV1> OnSelect { get; set; }

    [Parameter]
    public SceneSelectionV1? Selection { get; set; }

    [Parameter]
    public EventCallback<SceneSourceRefV1> OnFocus { get; set; }

    [Parameter]
    public EventCallback<SceneSemanticActionV1> OnAction { get; set; }

    [Parameter]
    public SceneSourceRefV1? FocusedSource { get; set; }

    [Parameter]
    public int PageSize { get; set; } = int.MaxValue;

    private HashSet<string> visibleSourceKeys = new(StringComparer.Ordinal);

    private HashSet<string> selectedSourceKeys = new(StringComparer.Ordinal);

    private IReadOnlyDictionary<string, IReadOnlyDictionary<string, object>>
        navigationAttributes = new Dictionary<string, IReadOnlyDictionary<string, object>>(
            StringComparer.Ordinal);

    private static IReadOnlyDictionary<string, object> EmptyAttributes { get; } =
        new Dictionary<string, object>(StringComparer.Ordinal);

    private int pageIndex;

    private int totalPages = 1;

    protected override void OnParametersSet()
    {
        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(PageSize);
        selectedSourceKeys = Selection?.Sources
            .Select(source => source.Key)
            .ToHashSet(StringComparer.Ordinal) ?? [];
        var sources = SemanticSources().ToArray();
        var pageCount = checked((sources.Length + (long)PageSize - 1) / PageSize);
        totalPages = checked((int)Math.Max(1L, pageCount));
        var focusedIndex = FocusedSource is null
            ? -1
            : Array.FindIndex(sources, source => string.Equals(
                source.Key,
                FocusedSource.Key,
                StringComparison.Ordinal));
        if (focusedIndex >= 0)
        {
            pageIndex = focusedIndex / PageSize;
        }

        pageIndex = Math.Min(pageIndex, totalPages - 1);
        SetVisibleSources(sources);
    }

    private SceneSourceRefV1? SetVisibleSources(IReadOnlyList<SceneSourceRefV1> sources)
    {
        var visibleSources = sources
            .Skip(checked(pageIndex * PageSize))
            .Take(PageSize)
            .ToArray();
        visibleSourceKeys = visibleSources.Select(source => source.Key)
            .ToHashSet(StringComparer.Ordinal);
        navigationAttributes = BuildNavigationAttributes(visibleSources);
        return visibleSources.Length == 0 ? null : visibleSources[0];
    }

    private IEnumerable<SceneSourceRefV1> SemanticSources()
    {
        if (Scene is null)
        {
            yield break;
        }

        foreach (var port in Scene.DefinitionPorts)
        {
            yield return DefinitionPortSource(port);
        }

        foreach (var component in Scene.Components)
        {
            yield return ComponentSource(component);
            foreach (var port in component.Ports)
            {
                yield return InstancePortSource(port);
            }
        }

        foreach (var annotation in Scene.Annotations)
        {
            yield return AnnotationSource(annotation);
        }

        foreach (var connection in Scene.Connections)
        {
            yield return NetSource(connection);
            foreach (var junction in connection.Junctions)
            {
                yield return JunctionSource(junction);
            }

            foreach (var wire in connection.WireGeometries)
            {
                yield return WireSource(wire);
            }
        }
    }

    private bool IsVisible(SceneSourceRefV1 source) => visibleSourceKeys.Contains(source.Key);

    private bool IsSelected(SceneSourceRefV1 source) => selectedSourceKeys.Contains(source.Key);

    private IReadOnlyDictionary<string, object> NavigationAttributes(
        SceneSourceRefV1 source) => navigationAttributes.TryGetValue(source.Key, out var attributes)
            ? attributes
            : EmptyAttributes;

    private IReadOnlyDictionary<string, IReadOnlyDictionary<string, object>>
        BuildNavigationAttributes(IReadOnlyList<SceneSourceRefV1> visibleSources)
    {
        if (Scene is null)
        {
            return new Dictionary<string, IReadOnlyDictionary<string, object>>(
                StringComparer.Ordinal);
        }

        var navigation = SceneSemanticNavigation.Project(Scene);
        var startKey = visibleSources.FirstOrDefault()?.Key;
        return visibleSources.ToDictionary(
            source => source.Key,
            source =>
            {
                var attributes = new Dictionary<string, object>(StringComparer.Ordinal);
                if (string.Equals(source.Key, startKey, StringComparison.Ordinal))
                {
                    attributes.Add("data-scene-navigation-start", string.Empty);
                }

                if (!navigation.TryGetValue(source.Key, out var neighbors))
                {
                    return (IReadOnlyDictionary<string, object>)attributes;
                }

                AddVisibleNeighbor(attributes, "up", neighbors.Up);
                AddVisibleNeighbor(attributes, "down", neighbors.Down);
                AddVisibleNeighbor(attributes, "left", neighbors.Left);
                AddVisibleNeighbor(attributes, "right", neighbors.Right);
                return attributes;
            },
            StringComparer.Ordinal);
    }

    private void AddVisibleNeighbor(
        IDictionary<string, object> attributes,
        string direction,
        string? sourceKey)
    {
        if (sourceKey is not null && visibleSourceKeys.Contains(sourceKey))
        {
            attributes.Add($"data-scene-navigation-{direction}", sourceKey);
        }
    }

    private bool ComponentIsVisible(AccessibleComponentProjection component) =>
        IsVisible(ComponentSource(component))
        || component.Ports.Any(port => IsVisible(InstancePortSource(port)));

    private bool ConnectionIsVisible(AccessibleConnectionProjection connection) =>
        IsVisible(NetSource(connection))
        || connection.Junctions.Any(junction => IsVisible(JunctionSource(junction)))
        || connection.WireGeometries.Any(wire => IsVisible(WireSource(wire)));

    private Task PreviousPageAsync()
    {
        pageIndex = Math.Max(0, pageIndex - 1);
        return PageChangedAsync();
    }

    private Task NextPageAsync()
    {
        pageIndex = Math.Min(totalPages - 1, pageIndex + 1);
        return PageChangedAsync();
    }

    private Task PageChangedAsync()
    {
        var firstVisibleSource = SetVisibleSources(SemanticSources().ToArray());
        return firstVisibleSource is null
            ? Task.CompletedTask
            : FocusAsync(firstVisibleSource);
    }

    private Task ActivateAsync(SceneSourceRefV1 source) => OnAction.HasDelegate
        ? OnAction.InvokeAsync(new ActivateSceneSemanticActionV1(source))
        : OnSelect.InvokeAsync(new SceneSelectionV1([source], "replace"));

    private Task RemoveAsync(SceneSourceRefV1 source) =>
        OnAction.InvokeAsync(new RemoveSceneSemanticActionV1(source));

    private Task FocusAsync(SceneSourceRefV1 source) => OnFocus.InvokeAsync(source);

    private static SceneSourceRefV1 DefinitionPortSource(
        AccessibleDefinitionPortProjection port) => new(
            port.Source.CircuitDefinitionId.Value,
            "definitionPort",
            port.Source.DefinitionPortId.Value);

    private static SceneSourceRefV1 ComponentSource(AccessibleComponentProjection component) =>
        new(
            component.Source.CircuitDefinitionId.Value,
            "componentInstance",
            component.Source.ComponentInstanceId.Value);

    private static SceneSourceRefV1 InstancePortSource(AccessiblePortProjection port) => new(
        port.Source.CircuitDefinitionId.Value,
        "instancePort",
        port.Source.ComponentInstanceId.Value,
        port.Source.PortId);

    private static SceneSourceRefV1 NetSource(AccessibleConnectionProjection connection) => new(
        connection.Source.CircuitDefinitionId.Value,
        "net",
        connection.Source.NetId.Value);

    private static SceneSourceRefV1 JunctionSource(AccessibleJunctionProjection junction) => new(
        junction.Source.CircuitDefinitionId.Value,
        "junction",
        junction.Source.JunctionId.Value);

    private static SceneSourceRefV1 WireSource(AccessibleWireGeometryProjection wire) => new(
        wire.Source.CircuitDefinitionId.Value,
        "wireGeometry",
        wire.Source.WireGeometryId.Value);

    private static SceneSourceRefV1 AnnotationSource(
        AccessibleAnnotationProjection annotation) => new(
            annotation.Source.CircuitDefinitionId.Value,
            "annotation",
            annotation.Source.AnnotationId.Value);

    private static string TerminalPath(
        AccessibleSceneProjection scene,
        AccessibleConnectionProjection connection)
    {
        return string.Join(" → ", connection.Terminals.Select(terminal => terminal switch
        {
            DefinitionTerminalReference definition => scene.DefinitionPorts.Single(port =>
                port.Source.DefinitionPortId == definition.DefinitionPortId).Label,
            InstanceTerminalReference instance => scene.Components
                .Single(component =>
                    component.Source.ComponentInstanceId == instance.ComponentInstanceId)
                .Ports.Single(port => string.Equals(
                    port.Source.PortId,
                    instance.PortId,
                    StringComparison.Ordinal)).Label,
            _ => throw new InvalidOperationException(
                "The Terminal Reference variant is undefined."),
        }));
    }

    private string WireRouteLabel(WireRoute route)
    {
        return route switch
        {
            UnroutedWireRoute => Text["Unrouted"],
            OrthogonalWireRoute orthogonal => Text[
                "WireOrthogonal",
                string.Join(" → ", orthogonal.Points.Select(point => $"{point.X},{point.Y}"))],
            _ => throw new InvalidOperationException("The Wire Route variant is undefined."),
        };
    }

    private string PortDirectionText(PortDirection direction)
    {
        return direction switch
        {
            PortDirection.Input => Text["PortDirectionInput"],
            PortDirection.Output => Text["PortDirectionOutput"],
            _ => throw new ArgumentOutOfRangeException(nameof(direction), direction, null),
        };
    }
}
