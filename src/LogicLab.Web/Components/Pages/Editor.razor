@page "/editor"
@rendermode InteractiveServer

<PageTitle>Sandbox Workbench</PageTitle>

<div class="workbench-shell">
    <header class="workbench-heading">
        <div>
            <p class="eyebrow">Slice 06 · first vertical tracer</p>
            <h1>Sandbox Workbench</h1>
        </div>
        <p>Author a one-bit input–NOT–output circuit, compile it, then advance one logical step.</p>
    </header>

    <WorkbenchCommandBar State="ViewState"
                         ActiveCommand="ActiveCommand"
                         OnCreate="@(() => RunCommandAsync(WorkbenchCommandKind.Create, CreateProject))"
                         OnAuthor="@(() => RunCommandAsync(WorkbenchCommandKind.Author, AuthorCircuit))"
                         OnCompile="@(() => RunCommandAsync(WorkbenchCommandKind.Compile, Compile))"
                         OnCreateSession="@(() => RunCommandAsync(WorkbenchCommandKind.CreateSession, CreateSimulationSession))"
                         OnScheduleStimulus="@(() => RunCommandAsync(WorkbenchCommandKind.ScheduleStimulus, ScheduleStimulus))"
                         OnStep="@(() => RunCommandAsync(WorkbenchCommandKind.Step, Step))" />

    <div class="workbench-grid">
        <AccessibleCircuitScene Scene="Scene" />
        <ProbePanel Simulation="Projection?.Simulation" />
    </div>

    <WorkbenchStatusStrip State="StatusState" Message="@Status" />
</div>
