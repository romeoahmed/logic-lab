@page "/editor"
@page "/editor/{WorkspaceIdValue}"
@rendermode InteractiveServer
<PageTitle>@EditorPageTitle</PageTitle>

<div class="workbench-shell">
    @if (AttachmentFailure is not null)
    {
        <section class="workspace-recovery"
                 data-workspace-attachment-error
                 data-error-code="@AttachmentFailure.Code"
                 aria-labelledby="workspace-recovery-title">
            <FluentCard class="workspace-recovery-card"
                        Appearance="CardAppearance.Outline"
                        Width="100%">
                <span class="workspace-recovery-mark" aria-hidden="true">!</span>
                <p class="eyebrow">@Text["WorkspaceUnavailable"]</p>
                <h1 id="workspace-recovery-title">@AttachmentFailure.Title</h1>
                <p class="workspace-recovery-description">@AttachmentFailure.Description</p>
                <div class="workspace-recovery-actions">
                    @if (AttachmentFailure.Code == WorkspaceOutcomeReasons.BuildFingerprintMismatch)
                    {
                        <FluentButton data-recovery="reload"
                                      Appearance="ButtonAppearance.Primary"
                                      OnClick="ReloadApplication">@Text["ReloadLogicLab"]</FluentButton>
                    }
                    else
                    {
                        <a class="recovery-primary"
                           data-recovery="projects"
                           href="/projects">@Text["ViewDurableProjects"]</a>
                        <a class="recovery-secondary"
                           data-recovery="sandbox"
                           href="/editor">@Text["StartNewSandbox"]</a>
                    }
                </div>
                <p class="workspace-error-code">@Text["ErrorCodeLabel"] <code>@AttachmentFailure.Code</code></p>
            </FluentCard>
        </section>
    }
    else
    {
        @if (Projection is null)
        {
            <header class="workbench-heading">
                <div class="workbench-identity">
                    <p class="eyebrow">@WorkbenchEyebrow</p>
                    <h1>@WorkbenchTitle</h1>
                </div>
                <div class="workbench-brief">
                    <span>@Text["WorkbenchBrief"]</span>
                    <p>@WorkbenchDescription</p>
                </div>
            </header>
        }

        <section class="workbench-deck">
            <div class="workbench-command-region">
                <WorkbenchCommandBar Model="CommandBarModel"
                                     OnCommand="RunWorkbenchCommandAsync"
                                     OnImport="ImportProjectPackage"
                                     ClaimDisplayNameChanged="UpdateClaimDisplayName" />
                @if (HasSaveConflict)
                {
                    <section class="save-conflict"
                             data-save-conflict
                             aria-labelledby="save-conflict-title">
                        <h2 id="save-conflict-title">@Text["ConflictTitle"]</h2>
                        <p>@Text["ConflictDescription"]</p>
                        <div>
                            <FluentButton data-conflict-recovery="reload"
                                          Appearance="ButtonAppearance.Primary"
                                          Disabled="@(ActiveCommand is not null)"
                                          OnClick="@(() => RunCommandAsync("conflict-reload", () => HasSaveConflict, ReloadDurableProject))">@Text["ConflictReloadRemote"]</FluentButton>
                            <FluentButton data-conflict-recovery="copy"
                                          Appearance="ButtonAppearance.Outline"
                                          Disabled="@(ActiveCommand is not null)"
                                          OnClick="@(() => RunCommandAsync("conflict-copy", () => HasSaveConflict, KeepConflictAsCopy))">@Text["ConflictKeepCopy"]</FluentButton>
                            <FluentButton data-conflict-recovery="export"
                                          Appearance="ButtonAppearance.Outline"
                                          Disabled="@(ActiveCommand is not null)"
                                          OnClick="@(() => RunCommandAsync("conflict-export", () => HasSaveConflict, PrepareProjectExport))">@Text["ConflictExportLocal"]</FluentButton>
                        </div>
                    </section>
                }
                @if (PreparedExportUrl is not null)
                {
                    <a class="export-download"
                       data-export-download
                       href="@PreparedExportUrl"
                       download="logiclab-project.logiclab">@Text["DownloadPackage"]</a>
                }
            </div>

            <div class="workbench-definition-region">
                <DefinitionNavigator Document="Projection?.ProjectRevision.Document"
                                     SelectedDefinitionId="SelectedDefinitionId"
                                     Breadcrumbs="Breadcrumbs"
                                     IsOccurrence="@(HierarchyNavigation.Count != 0)"
                                     CanSetEntry="CanSetEntryDefinition"
                                     CanEnterOccurrences="CanEnterDefinitionInstances"
                                     OnSelect="SelectDefinition"
                                     OnSetEntry="SetEntryDefinition"
                                     OnEnter="EnterDefinitionInstance"
                                     OnBack="LeaveDefinitionInstance" />
            </div>

            <div class="workbench-body">
                @if (Projection is not null && SelectedDefinitionId is not null)
                {
                    <div class="schematic-workspace">
                        <main class="canvas-workspace" data-testid="workbench-canvas">
                            <SceneToolStrip ActiveTool="SceneTool"
                                            HierarchyPath="CurrentSceneHierarchyPath"
                                            CanProbe="CanUseSceneProbe"
                                            ActiveToolChanged="ChangeSceneToolAsync" />
                            <CircuitSceneHost ProjectRevision="Projection.ProjectRevision"
                                              ProjectionVersion="Projection.ProjectionVersion"
                                              CircuitDefinitionId="SelectedDefinitionId"
                                              Selection="SceneSelection"
                                              ActiveTool="SceneTool"
                                              Simulation="Projection.Simulation"
                                              Compilation="Projection.Compilation"
                                              HierarchyPath="CurrentSceneHierarchyPath"
                                              OnSelect="HandleSceneSelectionAsync"
                                              OnIntent="HandleSceneIntentAsync"
                                              OnToolConsumed="ConsumeSceneToolAsync" />
                        </main>
                        <div class="library-dock" data-testid="workbench-library">
                            <ComponentPalette Options="ScenePlaceOptions"
                                              ActiveTool="SceneTool"
                                              ActiveToolChanged="ChangeSceneToolAsync" />
                        </div>
                        <aside class="inspector-dock" aria-labelledby="inspector-title">
                            <header class="inspector-heading">
                                <h2 id="inspector-title">@Text["Inspector"]</h2>
                                <p>@Text["InspectorDescription"]</p>
                            </header>
                            @if (CanAuthor)
                            {
                                <StarterGuide BusyCommand="@ActiveCommand"
                                              OnSelect="RunStarterExampleAsync" />
                            }
                            <details class="advanced-topology" open="@RouteDraftActive">
                                <summary>
                                    <span>@Text["AdvancedTopology"]</span>
                                    <small>@Text["AdvancedTopologyDescription"]</small>
                                </summary>
                                <div>
                                    <TopologyCommandBar CanMerge="CanMergeTopology"
                                                        CanSplit="CanSplitTopology"
                                                        CanAddJunction="CanAddJunction"
                                                        CanRemoveJunction="CanRemoveJunction"
                                                        CanPrepareRoute="CanPrepareRoute"
                                                        CanRoute="CanRoute"
                                                        CanUnroute="CanUnroute"
                                                        RouteDraftActive="RouteDraftActive"
                                                        ActiveCommand="@ActiveCommand"
                                                        OnMerge="@(() => RunCommandAsync("topology-merge", () => CanMergeTopology, MergeTopology))"
                                                        OnSplit="@(() => RunCommandAsync("topology-split", () => CanSplitTopology, SplitTopology))"
                                                        OnAddJunction="@(() => RunCommandAsync("topology-add-junction", () => CanAddJunction, AddJunction))"
                                                        OnRemoveJunction="@(() => RunCommandAsync("topology-remove-junction", () => CanRemoveJunction, RemoveJunction))"
                                                        OnPrepareRoute="PrepareRoute"
                                                        OnCommitRoute="@(() => RunCommandAsync("topology-commit-route", () => RouteDraftActive && CanEditTopology, CommitRoute))"
                                                        OnCancelRoute="CancelRoute"
                                                        OnRoute="@(() => RunCommandAsync("topology-route", () => CanRoute, RouteGeometry))"
                                                        OnUnroute="@(() => RunCommandAsync("topology-unroute", () => CanUnroute, UnrouteGeometry))" />
                                </div>
                            </details>
                        </aside>
                    </div>
                    <div class="instrument-bay" data-testid="instrument-bay">
                        <LogicAnalyzer Projection="Projection"
                                       TraceReader="ReadTraceWindowAsync"
                                       IsConnected="@CommandsAvailable"
                                       OnProbeOrderChanged="ReorderProbesAsync"
                                       OnRevealProbe="RevealProbeSourceAsync"
                                       OnRemoveProbe="RemoveProbeAsync"
                                       OnRebindProbe="RebindProbeAsync" />
                    </div>
                }
            </div>

            <div class="workbench-status-region">
                <WorkbenchStatusStrip Projection="Projection"
                                      IsConnected="IsInteractive"
                                      Message="@Status" />
            </div>
        </section>
    }

    <FluentProviders />
</div>
