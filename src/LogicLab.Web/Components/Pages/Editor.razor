@page "/editor"
@rendermode InteractiveServer

<PageTitle>Sandbox Workbench</PageTitle>

<div class="workbench-shell">
    <header class="workbench-heading">
        <div>
            <p class="eyebrow">Interactive circuit sandbox</p>
            <h1>Sandbox Workbench</h1>
        </div>
        <p>Create Circuit Definitions, navigate occurrences, choose an entry, compile, and simulate.</p>
    </header>

    <WorkbenchCommandBar CanCreate="CanCreate"
                         CanAuthor="CanAuthor"
                         CanAuthorSteering="CanAuthorSteering"
                         CanAuthorArithmetic="CanAuthorArithmetic"
                         CanAuthorHierarchy="CanAuthorHierarchy"
                         CanCompile="CanCompile"
                         CanCreateSession="CanCreateSession"
                         CanScheduleStimulus="CanScheduleStimulus"
                         CanStep="CanStep"
                         ActiveCommand="@WorkbenchActiveCommand"
                         OnCreate="@(() => RunCommandAsync("create", () => CanCreate, CreateProject))"
                         OnAuthor="@(() => RunCommandAsync("author", () => CanAuthor, AuthorCircuit))"
                         OnAuthorSteering="@(() => RunCommandAsync("author-steering", () => CanAuthorSteering, AuthorSteeringGallery))"
                         OnAuthorArithmetic="@(() => RunCommandAsync("author-arithmetic", () => CanAuthorArithmetic, AuthorArithmeticGallery))"
                         OnAuthorHierarchy="@(() => RunCommandAsync("author-hierarchy", () => CanAuthorHierarchy, AuthorHierarchy))"
                         OnCompile="@(() => RunCommandAsync("compile", () => CanCompile, Compile))"
                         OnCreateSession="@(() => RunCommandAsync("session", () => CanCreateSession, CreateSimulationSession))"
                         OnScheduleStimulus="@(() => RunCommandAsync("stimulus", () => CanScheduleStimulus, ScheduleStimulus))"
                         OnStep="@(() => RunCommandAsync("step", () => CanStep, Step))" />

    <DefinitionNavigator Document="Projection?.ProjectRevision.Document"
                         SelectedDefinitionId="SelectedDefinitionId"
                         Breadcrumbs="Breadcrumbs"
                         IsOccurrence="@(HierarchyNavigation.Count != 0)"
                         CanSetEntry="CanSetEntryDefinition"
                         CanEnterOccurrences="CanEnterDefinitionInstances"
                         OnSelect="SelectDefinition"
                         OnSetEntry="SetEntryDefinition"
                         OnEnter="EnterDefinitionInstance"
                         OnBack="LeaveDefinitionInstance" />

    <TopologyCommandBar CanMerge="CanMergeTopology"
                        CanSplit="CanSplitTopology"
                        CanAddJunction="CanAddJunction"
                        CanRemoveJunction="CanRemoveJunction"
                        CanPrepareRoute="CanPrepareRoute"
                        CanRoute="CanRoute"
                        CanUnroute="CanUnroute"
                        RouteDraftActive="RouteDraftActive"
                        ActiveCommand="@ActiveCommand"
                        OnMerge="@(() => RunCommandAsync("topology-merge", () => CanMergeTopology, MergeTopology))"
                        OnSplit="@(() => RunCommandAsync("topology-split", () => CanSplitTopology, SplitTopology))"
                        OnAddJunction="@(() => RunCommandAsync("topology-add-junction", () => CanAddJunction, AddJunction))"
                        OnRemoveJunction="@(() => RunCommandAsync("topology-remove-junction", () => CanRemoveJunction, RemoveJunction))"
                        OnPrepareRoute="PrepareRoute"
                        OnCommitRoute="@(() => RunCommandAsync("topology-commit-route", () => RouteDraftActive && CanEditTopology, CommitRoute))"
                        OnCancelRoute="CancelRoute"
                        OnRoute="@(() => RunCommandAsync("topology-route", () => CanRoute, RouteGeometry))"
                        OnUnroute="@(() => RunCommandAsync("topology-unroute", () => CanUnroute, UnrouteGeometry))" />

    <div class="workbench-grid">
        <AccessibleCircuitScene Scene="Scene" />
        <ProbePanel Simulation="Projection?.Simulation" />
    </div>

    <WorkbenchStatusStrip Projection="Projection"
                          IsConnected="IsInteractive"
                          Message="@Status" />
</div>
