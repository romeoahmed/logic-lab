@page "/"
@inject IStringLocalizer<SiteText> SiteText

<PageTitle>Logic Lab</PageTitle>

<section class="home-shell" aria-labelledby="home-title">
    <div class="home-hero">
        <FluentBadge Appearance="BadgeAppearance.Tint"
                     Color="BadgeColor.Brand"
                     Shape="BadgeShape.Rounded"
                     Size="BadgeSize.Small"
                     Content="@SiteText["HomeEyebrow"]" />
        <h1 id="home-title">@SiteText["HomeTitle"]</h1>
        <p class="lede">@SiteText["HomeDescription"]</p>
        <div class="hero-actions">
            <FluentAnchorButton class="primary-link"
                                Href="/editor"
                                Appearance="ButtonAppearance.Primary"
                                Size="ButtonSize.Large">
                @SiteText["HomeOpenWorkbench"] <span class="hero-action-arrow" aria-hidden="true">→</span>
            </FluentAnchorButton>
            <a class="secondary-link" href="#signal-path">@SiteText["HomeExplore"]</a>
        </div>
    </div>

    <FluentCard class="signal-path-card"
                Appearance="CardAppearance.Outline"
                Shadow="CardShadow.None"
                Width="100%">
        <div class="signal-path-heading" id="signal-path">
            <div>
                <p class="eyebrow">@SiteText["HomeSequenceEyebrow"]</p>
                <h2>@SiteText["HomeSequenceTitle"]</h2>
            </div>
            <FluentBadge Appearance="BadgeAppearance.Tint"
                         Color="BadgeColor.Success"
                         Shape="BadgeShape.Rounded"
                         Size="BadgeSize.Small"
                         Content="@SiteText["HomeReady"]" />
        </div>
        <FluentDivider Appearance="DividerAppearance.Subtle" />
        <ol class="signal-path-list">
            <li>
                <span class="stage-index">01</span>
                <div><h3>@SiteText["HomeAuthorTitle"]</h3><p>@SiteText["HomeAuthorDescription"]</p></div>
            </li>
            <li>
                <span class="stage-index">02</span>
                <div><h3>@SiteText["HomeCompileTitle"]</h3><p>@SiteText["HomeCompileDescription"]</p></div>
            </li>
            <li>
                <span class="stage-index">03</span>
                <div><h3>@SiteText["HomeSimulateTitle"]</h3><p>@SiteText["HomeSimulateDescription"]</p></div>
            </li>
            <li>
                <span class="stage-index">04</span>
                <div><h3>@SiteText["HomeInspectTitle"]</h3><p>@SiteText["HomeInspectDescription"]</p></div>
            </li>
        </ol>
    </FluentCard>
</section>
