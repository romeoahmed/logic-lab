@page "/account/register"
@attribute [ExcludeFromInteractiveRouting]
@using LogicLab.Infrastructure.Identity
@using LogicLab.Web.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.RateLimiting
@attribute [EnableRateLimiting(AccountIngressPolicy.RegistrationRateLimitPolicyName)]
@attribute [RequestSizeLimit(AccountIngressPolicy.MaximumRequestBodyBytes)]
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<AccountText> Text

<PageTitle>@Text["RegisterPageTitle"]</PageTitle>

<AccountShell Eyebrow="@Text["RegisterEyebrow"]"
              Title="@Text["RegisterTitle"]"
              Description="@Text["RegisterDescription"]">
    @if (errors is not null)
    {
        <div class="account-alert" role="alert">
            @foreach (var error in errors)
            {
                <p>@error.Description</p>
            }
        </div>
    }

    <EditForm class="account-form"
              Model="Input"
              method="post"
              FormName="register"
              OnValidSubmit="RegisterAsync"
              OnInvalidSubmit="ClearPasswords">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" />
        <div class="form-field">
            <FluentTextInput Id="register-email"
                             Name="Input.Email"
                             Label="@Text["Email"]"
                             aria-describedby="register-email-validation"
                             AutoComplete="username"
                             MaxLength="@AccountInputLimits.MaximumEmailLength"
                             Size="TextInputSize.Large"
                             Width="100%"
                             @bind-Value="Input.Email" />
            <div class="field-validation"
                 id="register-email-validation"
                 aria-live="polite">
                <ValidationMessage For="@(() => Input.Email)" />
            </div>
        </div>
        <div class="form-field">
            <FluentTextInput Id="register-password"
                             Name="Input.Password"
                             Label="@Text["Password"]"
                             aria-describedby="register-password-hint register-password-validation"
                             TextInputType="TextInputType.Password"
                             AutoComplete="new-password"
                             MaxLength="@AccountInputLimits.MaximumPasswordLength"
                             Size="TextInputSize.Large"
                             Width="100%"
                             @bind-Value="Input.Password" />
            <p class="field-hint" id="register-password-hint">
                @Text["RegisterPasswordHint"]
            </p>
            <div class="field-validation"
                 id="register-password-validation"
                 aria-live="polite">
                <ValidationMessage For="@(() => Input.Password)" />
            </div>
        </div>
        <div class="form-field">
            <FluentTextInput Id="register-confirm-password"
                             Name="Input.ConfirmPassword"
                             Label="@Text["ConfirmPassword"]"
                             aria-describedby="register-confirm-password-validation"
                             TextInputType="TextInputType.Password"
                             AutoComplete="new-password"
                             MaxLength="@AccountInputLimits.MaximumPasswordLength"
                             Size="TextInputSize.Large"
                             Width="100%"
                             @bind-Value="Input.ConfirmPassword" />
            <div class="field-validation"
                 id="register-confirm-password-validation"
                 aria-live="polite">
                <ValidationMessage For="@(() => Input.ConfirmPassword)" />
            </div>
        </div>
        <FluentButton Type="ButtonType.Submit"
                      Size="ButtonSize.Large"
                      Appearance="ButtonAppearance.Primary">@Text["RegisterSubmit"]</FluentButton>
    </EditForm>

    <p class="account-switch">@Text["RegisterAlreadyRegistered"] <a href="/account/login">@Text["RegisterLogIn"]</a></p>
</AccountShell>
