@page "/account/login"
@attribute [ExcludeFromInteractiveRouting]
@using LogicLab.Infrastructure.Identity
@using LogicLab.Web.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.RateLimiting
@attribute [EnableRateLimiting(AccountIngressPolicy.LoginRateLimitPolicyName)]
@attribute [RequestSizeLimit(AccountIngressPolicy.MaximumRequestBodyBytes)]
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<AccountText> Text

<PageTitle>@Text["LoginPageTitle"]</PageTitle>

<AccountShell Eyebrow="@Text["LoginEyebrow"]"
              Title="@Text["LoginTitle"]"
              Description="@Text["LoginDescription"]">
    @if (errorMessage is not null)
    {
        <div class="account-alert" role="alert">@errorMessage</div>
    }

    <EditForm class="account-form"
              Model="Input"
              method="post"
              FormName="login"
              OnValidSubmit="LogInAsync"
              OnInvalidSubmit="ClearPassword">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" />
        <div class="form-field">
            <FluentTextInput Id="login-email"
                             Name="Input.Email"
                             Label="@Text["Email"]"
                             aria-describedby="login-email-validation"
                             AutoComplete="username"
                             MaxLength="@AccountInputLimits.MaximumEmailLength"
                             Size="TextInputSize.Large"
                             Width="100%"
                             @bind-Value="Input.Email" />
            <div class="field-validation"
                 id="login-email-validation"
                 aria-live="polite">
                <ValidationMessage For="@(() => Input.Email)" />
            </div>
        </div>
        <div class="form-field">
            <FluentTextInput Id="login-password"
                             Name="Input.Password"
                             Label="@Text["Password"]"
                             aria-describedby="login-password-validation"
                             TextInputType="TextInputType.Password"
                             AutoComplete="current-password"
                             MaxLength="@AccountInputLimits.MaximumPasswordLength"
                             Size="TextInputSize.Large"
                             Width="100%"
                             @bind-Value="Input.Password" />
            <div class="field-validation"
                 id="login-password-validation"
                 aria-live="polite">
                <ValidationMessage For="@(() => Input.Password)" />
            </div>
        </div>
        <FluentCheckbox Name="Input.RememberMe"
                        Size="CheckboxSize.Large"
                        @bind-Value="Input.RememberMe">@Text["LoginRememberMe"]</FluentCheckbox>
        <FluentButton Type="ButtonType.Submit"
                      Size="ButtonSize.Large"
                      Appearance="ButtonAppearance.Primary">@Text["LoginSubmit"]</FluentButton>
    </EditForm>

    <p class="account-switch">@Text["LoginNewUser"] <a href="/account/register">@Text["LoginCreateAccount"]</a></p>
</AccountShell>
