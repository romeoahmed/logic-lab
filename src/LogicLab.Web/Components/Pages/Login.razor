@page "/account/login"
@attribute [ExcludeFromInteractiveRouting]
@using LogicLab.Infrastructure.Identity
@using LogicLab.Web.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.RateLimiting
@attribute [EnableRateLimiting(AccountIngressPolicy.LoginRateLimitPolicyName)]
@attribute [RequestSizeLimit(AccountIngressPolicy.MaximumRequestBodyBytes)]
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<AccountText> Text

<PageTitle>@Text["LoginPageTitle"]</PageTitle>

<AccountShell Title="@Text["LoginTitle"]"
              Description="@Text["LoginDescription"]">
    @if (errorMessage is not null)
    {
        <div class="account-alert" role="alert">@errorMessage</div>
    }

    <EditForm class="account-form"
              Model="Input"
              method="post"
              FormName="login"
              OnValidSubmit="LogInAsync"
              OnInvalidSubmit="ClearPassword">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" Model="Input" />
        <div class="form-field">
            <label for="login-email">@Text["Email"]</label>
            <InputText id="login-email" type="email"
                       name="Input.Email"
                       aria-describedby="login-email-validation"
                       autocomplete="username"
                       maxlength="@AccountInputLimits.MaximumEmailLength"
                       @bind-Value="Input.Email" />
            <div class="field-validation"
                 id="login-email-validation"
                 aria-live="polite">
                <ValidationMessage For="@(() => Input.Email)" />
            </div>
        </div>
        <div class="form-field">
            <label for="login-password">@Text["Password"]</label>
            <InputText id="login-password"
                       name="Input.Password"
                       aria-describedby="login-password-validation"
                       type="password"
                       autocomplete="current-password"
                       maxlength="@AccountInputLimits.MaximumPasswordLength"
                       @bind-Value="Input.Password" />
            <div class="field-validation"
                 id="login-password-validation"
                 aria-live="polite">
                <ValidationMessage For="@(() => Input.Password)" />
            </div>
        </div>
        <label class="remember-choice">
            <InputCheckbox name="Input.RememberMe" @bind-Value="Input.RememberMe" />
            @Text["LoginRememberMe"]
        </label>
        <button type="submit" class="account-submit">@Text["LoginSubmit"]</button>
    </EditForm>

    <p class="account-switch">@Text["LoginNewUser"] <a href="/account/register">@Text["LoginCreateAccount"]</a></p>
</AccountShell>
