@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<section class="error-page" aria-labelledby="error-title">
    <FluentCard class="error-card" Appearance="CardAppearance.Outline" Width="100%">
        <span class="error-mark" aria-hidden="true">!</span>
        <p class="eyebrow">Request interrupted</p>
        <h1 id="error-title">The workbench hit an unexpected fault.</h1>
        <p class="error-description">No recovery action was applied automatically. Return home and retry the operation when you are ready.</p>
        @if (ShowRequestId)
        {
            <p class="request-id"><strong>Request ID</strong><code>@RequestId</code></p>
        }
        <div class="error-actions">
            <a class="error-primary" href="/">Return home</a>
            <a href="/editor">Open a new Sandbox</a>
        </div>
    </FluentCard>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
