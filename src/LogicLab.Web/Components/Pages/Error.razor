@page "/Error"
@inject IStringLocalizer<SiteText> SiteText
@using System.Diagnostics

<PageTitle>@SiteText["ErrorPageTitle"]</PageTitle>

<section class="error-page" aria-labelledby="error-title">
    <FluentCard class="error-card" Appearance="CardAppearance.Outline" Width="100%">
        <span class="error-mark" aria-hidden="true">!</span>
        <p class="eyebrow">@SiteText["ErrorEyebrow"]</p>
        <h1 id="error-title">@SiteText["ErrorTitle"]</h1>
        <p class="error-description">@SiteText["ErrorDescription"]</p>
        @if (ShowRequestId)
        {
            <p class="request-id"><strong>@SiteText["ErrorRequestId"]</strong><code>@RequestId</code></p>
        }
        <div class="error-actions">
            <FluentAnchorButton class="error-primary"
                                Href="/"
                                Appearance="ButtonAppearance.Primary">@SiteText["ErrorReturnHome"]</FluentAnchorButton>
            <a href="/editor">@SiteText["ErrorOpenSandbox"]</a>
        </div>
    </FluentCard>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
