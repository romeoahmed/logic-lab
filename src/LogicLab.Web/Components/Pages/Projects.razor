@page "/projects"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@inject LogicLab.Web.Projects.DurableProjectCatalogPageState PageState
@inject IStringLocalizer<ProjectCatalogText> Text
<PageTitle>@Text["PageTitle"]</PageTitle>

<section class="projects-shell" aria-labelledby="projects-title">
    <header class="projects-heading">
        <div>
            <FluentBadge Appearance="BadgeAppearance.Tint"
                         Color="BadgeColor.Brand"
                         Shape="BadgeShape.Rounded"
                         Size="BadgeSize.Small"
                         Content="@Text["PrivateCatalog"]" />
            <h1 id="projects-title">@Text["PageTitle"]</h1>
        </div>
        <p>@Text["Description"]</p>
    </header>

    <FluentCard class="catalog-card"
                Appearance="CardAppearance.Outline"
                Width="100%">
        <div class="catalog-card-heading">
            <div>
                <p class="projects-eyebrow">@Text["Eyebrow"]</p>
                <h2>@Text["IndexTitle"]</h2>
            </div>
            <FluentBadge Appearance="BadgeAppearance.Outline"
                         Color="BadgeColor.Brand"
                         Shape="BadgeShape.Rounded"
                         Size="BadgeSize.Small"
                         Content="@VisibleProjectCount" />
        </div>
        <FluentDivider Appearance="DividerAppearance.Subtle" />
        @if (Page.Items.Count == 0)
        {
            <div class="catalog-empty" data-catalog-empty role="status">
                <span class="catalog-empty-mark" aria-hidden="true">◇</span>
                <h2>@Text["EmptyTitle"]</h2>
                <p>@Text["EmptyDescription"]</p>
                <FluentAnchorButton Href="/editor"
                                    Appearance="ButtonAppearance.Primary">
                    @Text["EmptyOpenWorkbench"]
                </FluentAnchorButton>
            </div>
        }
        else
        {
            <ul class="project-catalog">
                @foreach (var item in Page.Items)
                {
                    <li data-project-id="@item.DurableProjectId.Value">
                        <span class="project-mark" aria-hidden="true">◆</span>
                        <bdi dir="auto">@item.DisplayName.Value</bdi>
                        <form action="/projects/open" method="post">
                            <AntiforgeryToken />
                            <input type="hidden"
                                   name="durableProjectId"
                                   value="@item.DurableProjectId.Value" />
                            <FluentButton Class="project-open"
                                          Type="ButtonType.Submit"
                                          Appearance="ButtonAppearance.Primary">
                                @Text["OpenProject"]
                            </FluentButton>
                        </form>
                    </li>
                }
            </ul>
        }
    </FluentCard>

    @if (Page.Next is not null)
    {
        <nav class="catalog-pagination">
            <FluentAnchorButton data-projects-next
                                Href="@NextPage(Page.Next)"
                                Appearance="ButtonAppearance.Outline">
                @Text["NextPage"] <span aria-hidden="true">→</span>
            </FluentAnchorButton>
        </nav>
    }
</section>

@code {
    private DurableProjectPage Page => PageState.Page
        ?? throw new InvalidOperationException(
            "The Durable Project Catalog page was not loaded before rendering.");

    private string VisibleProjectCount => Page.Items.Count == 1
        ? Text["ProjectCountOne"]
        : Text["ProjectCountOther", Page.Items.Count];

    private static string NextPage(ProjectCatalogCursor cursor)
    {
        return $"/projects?after={Uri.EscapeDataString(cursor.Value)}";
    }
}
