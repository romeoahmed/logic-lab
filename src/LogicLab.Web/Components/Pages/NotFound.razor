@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<SiteText> SiteText

<PageTitle>@SiteText["NotFoundPageTitle"]</PageTitle>

<section class="not-found" aria-labelledby="not-found-title">
    <FluentCard class="not-found-card" Appearance="CardAppearance.Outline" Width="100%">
        <span class="error-coordinate" aria-hidden="true">404</span>
        <p class="eyebrow">@SiteText["NotFoundEyebrow"]</p>
        <h1 id="not-found-title">@SiteText["NotFoundTitle"]</h1>
        <p>@SiteText["NotFoundDescription"]</p>
        <div class="recovery-actions">
            <FluentAnchorButton class="recovery-link"
                                Href="/editor"
                                Appearance="ButtonAppearance.Primary">@SiteText["NotFoundOpenWorkbench"]</FluentAnchorButton>
            <a class="recovery-secondary" href="/">@SiteText["NotFoundReturnHome"]</a>
        </div>
    </FluentCard>
</section>
