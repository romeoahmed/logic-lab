@page "/not-found"
@layout MainLayout

<PageTitle>Not Found</PageTitle>

<section class="not-found" aria-labelledby="not-found-title">
    <FluentCard class="not-found-card" Appearance="CardAppearance.Outline" Width="100%">
        <span class="error-coordinate" aria-hidden="true">404</span>
        <p class="eyebrow">Page not found</p>
        <h1 id="not-found-title">This path ends here.</h1>
        <p>The address does not match a Logic Lab surface. Return to the workbench or start from home.</p>
        <div class="recovery-actions">
            <FluentAnchorButton class="recovery-link"
                                Href="/editor"
                                Appearance="ButtonAppearance.Primary">Open Workbench</FluentAnchorButton>
            <a class="recovery-secondary" href="/">Return home</a>
        </div>
    </FluentCard>
</section>
