@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to content</a>

<header class="site-header">
    <div class="site-header-inner">
        <a class="brand" href="/" aria-label="Logic Lab home">
            <span class="brand-mark" aria-hidden="true">
                <span>LL</span>
                <i></i>
            </span>
            <span class="brand-copy">
                <span class="brand-name">Logic Lab</span>
                <small>Deterministic circuits</small>
            </span>
        </a>
        <nav class="primary-navigation" aria-label="Primary navigation">
            <NavLink href="/editor">Workbench</NavLink>
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/projects">Projects</NavLink>
                    <form class="logout-form" action="/account/logout" method="post">
                        <AntiforgeryToken />
                        <button class="navigation-button" type="submit">Log out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="/account/login">Log in</NavLink>
                    <NavLink class="navigation-accent" href="/account/register">Register</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>

<main id="main-content" tabindex="-1">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    <strong>Logic Lab needs attention.</strong>
    <span>An unexpected client error interrupted this surface.</span>
    <a href="." class="reload">Reload</a>
    <button class="dismiss" type="button" aria-label="Dismiss error">×</button>
</div>
