@inherits LayoutComponentBase
@inject IStringLocalizer<LayoutText> Text

<a class="skip-link" href="#main-content">@Text["SkipToContent"]</a>

<header class="site-header">
    <div class="site-header-inner">
        <a class="brand" href="/" aria-label="@Text["HomeAriaLabel"]">
            <span class="brand-mark" aria-hidden="true">
                <span>LL</span>
                <i></i>
            </span>
            <span class="brand-copy">
                <span class="brand-name">Logic Lab</span>
                <small>@Text["BrandTagline"]</small>
            </span>
        </a>
        <nav class="primary-navigation" aria-label="@Text["PrimaryNavigationAriaLabel"]">
            <NavLink href="/editor">@Text["Workbench"]</NavLink>
            <NavLink href="/help/getting-started">@Text["Help"]</NavLink>
            @if (IsHttps)
            {
                <form class="culture-form" data-culture-form action="/culture" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@CurrentLocalUrl" />
                    <label>
                        <span class="visually-hidden">@Text["Language"]</span>
                        <select name="culture">
                            <option value="@LogicLabCultures.English" selected="@(CultureInfo.CurrentUICulture.Name == LogicLabCultures.English)">English</option>
                            <option value="@LogicLabCultures.SimplifiedChinese" selected="@(CultureInfo.CurrentUICulture.Name == LogicLabCultures.SimplifiedChinese)">简体中文</option>
                        </select>
                    </label>
                    <button class="navigation-button" type="submit">@Text["Apply"]</button>
                </form>
            }
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/projects">@Text["Projects"]</NavLink>
                    <form class="logout-form" action="/account/logout" method="post">
                        <AntiforgeryToken />
                        <button class="navigation-button" type="submit">@Text["LogOut"]</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="/account/login">@Text["LogIn"]</NavLink>
                    <NavLink class="navigation-accent" href="/account/register">@Text["Register"]</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>

<main id="main-content" tabindex="-1" data-browser-host-ancestor>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    <strong>@Text["ErrorTitle"]</strong>
    <span>@Text["ErrorMessage"]</span>
    <a href="." class="reload">@Text["Reload"]</a>
    <button class="dismiss" type="button" aria-label="@Text["DismissError"]">×</button>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    private string CurrentLocalUrl
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            return string.IsNullOrEmpty(relative) ? "/" : $"/{relative}";
        }
    }

    private bool IsHttps => Navigation.Uri.StartsWith(
        "https://",
        StringComparison.OrdinalIgnoreCase);
}
