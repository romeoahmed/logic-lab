@inherits LayoutComponentBase

<header class="site-header">
    <a class="brand" href="/" aria-label="Logic Lab home">
        <span class="brand-mark" aria-hidden="true">LL</span>
        <span>Logic Lab</span>
    </a>
    <nav class="primary-navigation" aria-label="Primary navigation">
        <a href="/editor">Workbench</a>
        <AuthorizeView>
            <Authorized>
                <a href="/projects">Projects</a>
                <form class="logout-form" action="/account/logout" method="post">
                    <AntiforgeryToken />
                    <button class="navigation-button" type="submit">Log out</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a href="/account/login">Log in</a>
                <a href="/account/register">Register</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
